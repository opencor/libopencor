                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_rgl_W</ci>
                <apply>
                    <times/>
                    <ci>k_gl_W</ci>
                    <apply>
                        <minus/>
                        <ci>u_rGlomerulusC</ci>
                        <ci>u_rpt_W</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_rgl_Na</ci>
                <apply>
                    <times/>
                    <ci>kK_gl_Na</ci>
                    <apply>
