                    <ci>q_rGlomerulusC</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <ci>v_rRenalA</ci>
                        <ci>v_rEffArteriol</ci>
                    </apply>
                    <ci>v_rgl_W</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_rGlomerulusC</ci>
                <apply>
                    <times/>
                    <ci>E_rGlomerulusC</ci>
