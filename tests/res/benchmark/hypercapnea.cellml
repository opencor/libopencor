        </math>
        <!-- ===========      Blood Volume Control: GI        ===========-->
        <!-- outputs-->
        <variable initial_value="0.0282852352956092" name="q_gi_W" units="litre"/>
        <variable name="c_gi_Na" units="mol_per_L"/>
        <variable name="C_gi_Na" units="mM"/>
        <variable initial_value="0.00413018483992228" name="q_gi_Na" units="mole"/>
        <variable initial_value="0.00104446781277001" name="q_giEpi_Na" units="mole"/>
        <variable name="c_giEpi_Na" units="mol_per_L"/>
        <variable name="C_giEpi_Na" units="mM"/>
        <variable name="c_intestineC_Na" units="mol_per_L"/>
        <variable name="C_intestineC_Na" units="mM"/>
        <variable name="u_gi_osmotic" units="kPa"/>
        <variable name="u_intestineC_osmotic" units="kPa"/>
        <variable initial_value="-0.040" name="u_giEpi_e" units="J_per_C"/>
        <variable name="v_gi_W" units="L_per_s"/>
        <variable name="v_gi_Na" units="mol_per_s"/>
        <variable name="v_giEpi_NKE" units="mol_per_s"/>
        <variable initial_value="0.03" name="q_intestineC_K" units="mole"/>
        <!-- boundary conditions-->
        <variable initial_value="0" name="v_giOut_W" units="L_per_s"/>
        <variable initial_value="1.16e-6" name="v_giOut_Na" units="mol_per_s"/>
        <variable initial_value="0" name="v_giIn_W0" units="L_per_s"/>
        <variable name="v_giIn_W" units="L_per_s"/>
        <variable initial_value="1.16e-6" name="v_giIn_Na0" units="mol_per_s"/>
        <variable name="v_giIn_Na" units="mol_per_s"/>
        <!-- constants-->
        <variable initial_value="0.5" name="q_giEpi_W" units="litre"/>
        <variable initial_value="1e-3" name="k_gi_W" units="L_per_s_per_kPa"/>
        <variable initial_value="1" name="kK_gi_Na" units="per_s"/>
        <variable initial_value="1e5" name="k_giEpi_NKE" units="mol_per_s"/>
        <variable initial_value="0.012" name="q_giEpi_K" units="mole"/>
        <!-- equations-->
        <!--==========        Simulation protocol        ==========-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_giIn_W</ci>
                <piecewise>
                    <piece>
                        <ci>v_giIn_W0</ci>
                        <apply>
                            <or/>
                            <apply>
                                <lt/>
                                <ci>t</ci>
                                <ci>t_start_v_giIn_W</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>t</ci>
                                <ci>t_end_v_giIn_W</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <plus/>
                            <ci>v_giIn_W0</ci>
                            <ci>v_giIn_W_adder</ci>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>v_giIn_Na</ci>
                <piecewise>
                    <piece>
                        <ci>v_giIn_Na0</ci>
                        <apply>
                            <or/>
                            <apply>
                                <lt/>
                                <ci>t</ci>
                                <ci>t_start_v_giIn_Na</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>t</ci>
                                <ci>t_end_v_giIn_Na</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <plus/>
                            <ci>v_giIn_Na0</ci>
                            <ci>v_giIn_Na_adder</ci>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <!--=======================================================-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_gi_W</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <ci>v_giIn_W</ci>
                        <ci>v_gi_W</ci>
                    </apply>
                    <ci>v_giOut_W</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_gi_Na</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <ci>v_giIn_Na</ci>
                        <ci>v_gi_Na</ci>
                    </apply>
                    <ci>v_giOut_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_giEpi_Na</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>v_gi_Na</ci>
                    <ci>v_giEpi_NKE</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>c_gi_Na</ci>
                <apply>
                    <divide/>
                    <ci>q_gi_Na</ci>
                    <ci>q_gi_W</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>c_giEpi_Na</ci>
                <apply>
                    <divide/>
                    <ci>q_giEpi_Na</ci>
                    <ci>q_giEpi_W</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>c_intestineC_Na</ci>
                <apply>
                    <divide/>
                    <ci>q_vc_Na</ci>
                    <ci>q_intestineC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>C_gi_Na</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dim" type="e-notation">1<sep/>3</cn>
                    <ci>c_gi_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>C_giEpi_Na</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dim" type="e-notation">1<sep/>3</cn>
                    <ci>c_giEpi_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>C_intestineC_Na</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dim" type="e-notation">1<sep/>3</cn>
                    <ci>c_intestineC_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_gi_osmotic</ci>
                <apply>
                    <times/>
                    <ci>RT</ci>
                    <ci>c_gi_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_intestineC_osmotic</ci>
                <apply>
                    <times/>
                    <ci>RT</ci>
                    <ci>c_intestineC_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_gi_W</ci>
                <apply>
                    <times/>
                    <ci>k_gi_W</ci>
                    <apply>
                        <minus/>
                        <ci>u_intestineC_osmotic</ci>
                        <ci>u_gi_osmotic</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_gi_Na</ci>
                <apply>
                    <times/>
                    <ci>kK_gi_Na</ci>
                    <apply>
                        <minus/>
                        <ci>q_gi_Na</ci>
                        <ci>q_giEpi_Na</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_giEpi_NKE</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="dim">3</cn>
                        <ci>k_giEpi_NKE</ci>
                        <apply>
                            <minus/>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_Na</ci>
                                            <ci>q_giEpi_Na</ci>
                                        </apply>
                                        <ci>q_giEpi_W</ci>
                                    </apply>
                                    <cn cellml:units="dim">3</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_K</ci>
                                            <ci>q_intestineC_K</ci>
                                        </apply>
                                        <ci>q_intestineC</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_Na</ci>
                                            <ci>q_vc_Na</ci>
                                        </apply>
                                        <ci>q_intestineC</ci>
                                    </apply>
                                    <cn cellml:units="dim">3</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_K</ci>
                                            <ci>q_giEpi_K</ci>
                                        </apply>
                                        <ci>q_giEpi_W</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <cn cellml:units="dim">2</cn>
                                            <ci>F</ci>
                                            <ci>u_giEpi_e</ci>
                                        </apply>
                                        <ci>RT</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <cn cellml:units="dim">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_Na</ci>
                                        <ci>q_giEpi_Na</ci>
                                    </apply>
                                    <ci>q_giEpi_W</ci>
                                </apply>
                                <cn cellml:units="dim">3</cn>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dim">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_Na</ci>
                                        <ci>q_vc_Na</ci>
                                    </apply>
                                    <ci>q_intestineC</ci>
                                </apply>
                                <cn cellml:units="dim">3</cn>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dim">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_K</ci>
                                        <ci>q_intestineC_K</ci>
                                    </apply>
                                    <ci>q_intestineC</ci>
                                </apply>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dim">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_K</ci>
                                        <ci>q_giEpi_K</ci>
                                    </apply>
                                    <ci>q_giEpi_W</ci>
                                </apply>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <!-- ===========      Control Na across compartments        ===========-->
        <variable name="q_tot_Na" units="mole"/>
        <variable initial_value="0.0114979848860844" name="q_vc_Na" units="mole"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_vc_Na</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <apply>
                            <plus/>
                            <ci>v_giEpi_NKE</ci>
                            <ci>v_lptEpi_NKE</ci>
                            <ci>v_rptEpi_NKE</ci>
                        </apply>
                        <ci>v_lgl_Na</ci>
                    </apply>
                    <ci>v_rgl_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q_tot_Na</ci>
                <apply>
                    <plus/>
                    <ci>q_vc_Na</ci>
                    <ci>q_gi_Na</ci>
                    <ci>q_lpt_Na</ci>
                    <ci>q_rpt_Na</ci>
                    <ci>q_giEpi_Na</ci>
                    <ci>q_rptEpi_Na</ci>
                    <ci>q_lptEpi_Na</ci>
                </apply>
            </apply>
        </math>
    </component>
</model>
