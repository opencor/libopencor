                                    <apply>
                                        <times/>
                                        <ci>K_K</ci>
                                        <ci>q_rptEpi_K</ci>
                                    </apply>
                                    <ci>q_rptEpi_W</ci>
                                </apply>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
