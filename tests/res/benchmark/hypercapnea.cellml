                    </apply>
                    <ci>R_rRenalV</ci>
                </apply>
            </apply>
        </math>
        <!-- Inferior mesentery branch of the aorta -->
        <variable name="v_infMesA" units="L_per_s"/>
        <variable initial_value="100" name="R_infMesA" units="kPa_s_per_L"/>
