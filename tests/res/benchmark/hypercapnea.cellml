                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_rPeritubularC</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <minus/>
                        <ci>v_rEffArteriol</ci>
                        <ci>v_rRenalV</ci>
                    </apply>
                    <ci>v_rpt_W</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_rPeritubularC</ci>
                <apply>
                    <times/>
                    <ci>E_rPeritubularC</ci>
                    <apply>
                        <minus/>
                        <ci>q_rPeritubularC</ci>
                        <ci>q_rPeritubularC_us</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!-- -> changing to non-linear elastic J-shape curve-->
        <!--        u_rPeritubularC = E_rPeritubularC*(q_rPeritubularC-q_rPeritubularC_us)/sqr(L_rPeritubularC-q_rPeritubularC);-->
        <variable name="v_rRenalV" units="L_per_s"/>
        <variable initial_value="100" name="R_rRenalV" units="kPa_s_per_L"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_rRenalV</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_rPeritubularC</ci>
