        </math>
        <!-- Inferior vena cava-->
        <variable initial_value="0.0659701328834496" name="q_V1" units="litre"/>
        <variable initial_value="0.06" name="q_V1_us" units="litre"/>
        <variable initial_value="0.0654476623947056" name="q_V2" units="litre"/>
        <variable initial_value="0.06" name="q_V2_us" units="litre"/>
