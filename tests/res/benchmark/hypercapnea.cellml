        </math>
        <variable initial_value="0.209161525112732" name="q_rGlomerulusC" units="litre"/>
        <variable initial_value="0.2" name="q_rGlomerulusC_us" units="litre"/>
        <variable name="u_rGlomerulusC" units="kPa"/>
