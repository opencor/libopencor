            <apply>
                <eq/>
                <ci>u_V4</ci>
                <apply>
                    <times/>
                    <ci>E_V4</ci>
                    <apply>
                        <minus/>
                        <ci>q_V4</ci>
                        <ci>q_V4_us</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_V5</ci>
                <apply>
                    <times/>
                    <ci>E_V5</ci>
                    <apply>
                        <minus/>
                        <ci>q_V5</ci>
                        <ci>q_V5_us</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_V6</ci>
                <apply>
                    <times/>
                    <ci>E_V6_ctl</ci>
                    <apply>
                        <minus/>
                        <ci>q_V6</ci>
                        <ci>q_V6_usCtl</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--        u_V1 = E_V1*(q_V1-q_V1_us)/sqr(L_V1-q_V1);
        u_V2 = E_V2*(q_V2-q_V2_us)/sqr(L_V2-q_V2);
        u_V3 = E_V3*(q_V3-q_V3_us)/sqr(L_V3-q_V3);
        u_V4 = E_V4*(q_V4-q_V4_us)/sqr(L_V4-q_V4);
        u_V5 = E_V5*(q_V5-q_V5_us)/sqr(L_V5-q_V5);
        u_V6 = E_V6*(q_V6-q_V6_us)/sqr(L_V6-q_V6);-->
        <variable initial_value="100" name="R_V1" units="kPa_s_per_L"/>
        <variable initial_value="100" name="R_V2" units="kPa_s_per_L"/>
        <variable initial_value="100" name="R_V3" units="kPa_s_per_L"/>
        <variable initial_value="100" name="R_V4" units="kPa_s_per_L"/>
        <variable initial_value="100" name="R_V5" units="kPa_s_per_L"/>
        <variable initial_value="100" name="R_V6" units="kPa_s_per_L"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_V1</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_V1</ci>
                        <ci>u_ra</ci>
                    </apply>
                    <ci>R_V1</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_V2</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_V2</ci>
                        <ci>u_V1</ci>
                    </apply>
                    <ci>R_V2</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_V3</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_V3</ci>
                        <ci>u_V2</ci>
                    </apply>
                    <ci>R_V3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_V4</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_V4</ci>
                        <ci>u_V3</ci>
                    </apply>
                    <ci>R_V4</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_V5</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_V5</ci>
                        <ci>u_V4</ci>
                    </apply>
                    <ci>R_V5</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_V6</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_V6</ci>
                        <ci>u_V5</ci>
                    </apply>
                    <ci>R_V6</ci>
                </apply>
            </apply>
        </math>
        <!-- Left leg-->
        <variable name="v_lCommonIliacA" units="L_per_s"/>
        <variable initial_value="100" name="R_lCommonIliacA" units="kPa_s_per_L"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_lCommonIliacA</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_A8</ci>
                        <ci>u_lLegC</ci>
                    </apply>
                    <ci>R_lCommonIliacA</ci>
                </apply>
            </apply>
        </math>
        <variable initial_value="0.0722132318271499" name="q_lLegC" units="litre"/>
        <variable initial_value="0.06" name="q_lLegC_us" units="litre"/>
        <variable name="u_lLegC" units="kPa"/>
        <variable initial_value="150" name="E_lLegC" units="kPa_per_L"/>
        <variable initial_value="1" name="L_lLegC" units="liter"/>
        <!-- TODO: must be replaced with physiological value-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_lLegC</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>v_lCommonIliacA</ci>
                    <ci>v_lCommonIliacV</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_lLegC</ci>
                <apply>
                    <times/>
                    <ci>E_lLegC</ci>
                    <apply>
                        <minus/>
                        <ci>q_lLegC</ci>
                        <ci>q_lLegC_us</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!-- -> changing to non-linear elastic J-shape curve-->
        <!--        u_lLegC = E_lLegC*(q_lLegC-q_lLegC_us)/sqr(L_lLegC-q_lLegC);-->
        <variable name="v_lCommonIliacV" units="L_per_s"/>
        <variable initial_value="4000" name="R_lCommonIliacV" units="kPa_s_per_L"/>
        <variable name="R_lCommonIliacV_cont" units="kPa_s_per_L"/>
        <!-- controlling and modulating the resistance by ANS
 unit conversion is needed fpr Delta_armLeg_theta-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>R_lCommonIliacV_cont</ci>
                <apply>
                    <plus/>
                    <ci>R_lCommonIliacV</ci>
                    <apply>
                        <times/>
                        <cn cellml:units="kPa_m6_per_LJ" type="e-notation">1<sep/>-6</cn>
                        <ci>Delta_armLeg_theta</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_lCommonIliacV</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_lLegC</ci>
                        <ci>u_V6</ci>
                    </apply>
                    <ci>R_lCommonIliacV_cont</ci>
                </apply>
            </apply>
        </math>
        <!-- Right leg-->
        <variable name="v_rCommonIliacA" units="L_per_s"/>
        <variable initial_value="100" name="R_rCommonIliacA" units="kPa_s_per_L"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_rCommonIliacA</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_A8</ci>
                        <ci>u_rLegC</ci>
                    </apply>
                    <ci>R_rCommonIliacA</ci>
                </apply>
            </apply>
        </math>
        <variable initial_value="0.0722132318271499" name="q_rLegC" units="litre"/>
        <variable initial_value="0.06" name="q_rLegC_us" units="litre"/>
        <variable name="u_rLegC" units="kPa"/>
        <variable initial_value="150" name="E_rLegC" units="kPa_per_L"/>
        <variable initial_value="1" name="L_rLegC" units="liter"/>
        <!-- TODO: must be replaced with physiological value-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_rLegC</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>v_rCommonIliacA</ci>
                    <ci>v_rCommonIliacV</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_rLegC</ci>
                <apply>
                    <times/>
                    <ci>E_rLegC</ci>
                    <apply>
                        <minus/>
                        <ci>q_rLegC</ci>
                        <ci>q_rLegC_us</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!-- -> changing to non-linear elastic J-shape curve-->
        <!--        u_rLegC = E_rLegC*(q_rLegC-q_rLegC_us)/sqr(L_rLegC-q_rLegC);-->
        <variable name="v_rCommonIliacV" units="L_per_s"/>
        <variable initial_value="4000" name="R_rCommonIliacV" units="kPa_s_per_L"/>
        <variable name="R_rCommonIliacV_cont" units="kPa_s_per_L"/>
        <!-- controlling and modulating the resistance by ANS
 unit conversion is needed fpr Delta_armLeg_theta-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>R_rCommonIliacV_cont</ci>
                <apply>
                    <plus/>
                    <ci>R_rCommonIliacV</ci>
                    <apply>
                        <times/>
                        <cn cellml:units="kPa_m6_per_LJ" type="e-notation">1<sep/>-6</cn>
                        <ci>Delta_armLeg_theta</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_rCommonIliacV</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>u_rLegC</ci>
                        <ci>u_V6</ci>
                    </apply>
                    <ci>R_rCommonIliacV_cont</ci>
                </apply>
            </apply>
        </math>
        <!-- Total volumes of blood in regions-->
        <variable name="q_TotHeart" units="litre"/>
        <variable name="q_TotLung" units="litre"/>
        <variable name="q_TotHead" units="litre"/>
        <variable name="q_TotThoracic" units="litre"/>
        <variable name="q_TotAorta" units="litre"/>
        <variable name="q_TotRenal" units="litre"/>
        <variable name="q_TotGut" units="litre"/>
        <variable name="q_TotVenaCava" units="litre"/>
        <variable name="q_TotLimbs" units="litre"/>
        <variable name="q_TotBlood" units="litre"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>q_TotHeart</ci>
                <apply>
                    <plus/>
                    <ci>q_ra</ci>
                    <ci>q_rv</ci>
                    <ci>q_la</ci>
                    <ci>q_lv</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q_TotLung</ci>
                <apply>
                    <plus/>
                    <ci>q_lungC</ci>
                    <ci>q_pulmA</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q_TotHead</ci>
                <apply>
                    <plus/>
                    <ci>q_brachiocephalicA</ci>
                    <ci>q_rSubclavianA</ci>
                    <ci>q_lSubclavianA</ci>
                    <ci>q_headC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q_TotThoracic</ci>
                <apply>
                    <plus/>
                    <ci>q_lAdrenalGlandC</ci>
                    <ci>q_lInfPhrenicV</ci>
                    <ci>q_rAdrenalGlandC</ci>
                    <ci>q_rInfPhrenicV</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q_TotAorta</ci>
                <apply>
                    <plus/>
                    <ci>q_AA</ci>
                    <ci>q_A1</ci>
                    <ci>q_A2</ci>
                    <ci>q_A3</ci>
                    <ci>q_A4</ci>
                    <ci>q_A5</ci>
                    <ci>q_A6</ci>
                    <ci>q_A7</ci>
                    <ci>q_A8</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q_TotRenal</ci>
                <apply>
                    <plus/>
                    <ci>q_lGlomerulusC</ci>
                    <ci>q_lPeritubularC</ci>
                    <ci>q_rGlomerulusC</ci>
                    <ci>q_rPeritubularC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q_TotGut</ci>
                <apply>
                    <plus/>
                    <ci>q_celiacA</ci>
                    <ci>q_supMesA</ci>
                    <ci>q_stomachC</ci>
                    <ci>q_spleenC</ci>
                    <ci>q_pancreasC</ci>
                    <ci>q_intestineC</ci>
                    <ci>q_colonC</ci>
                    <ci>q_portalV</ci>
                    <ci>q_liverC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q_TotVenaCava</ci>
                <apply>
                    <plus/>
                    <ci>q_V1</ci>
                    <ci>q_V2</ci>
                    <ci>q_V3</ci>
                    <ci>q_V4</ci>
                    <ci>q_V5</ci>
                    <ci>q_V6</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q_TotLimbs</ci>
                <apply>
                    <plus/>
                    <ci>q_lArmC</ci>
                    <ci>q_rArmC</ci>
                    <ci>q_lLegC</ci>
                    <ci>q_rLegC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q_TotBlood</ci>
                <apply>
                    <plus/>
                    <ci>q_TotHeart</ci>
                    <ci>q_TotLung</ci>
                    <ci>q_TotHead</ci>
                    <ci>q_TotThoracic</ci>
                    <ci>q_TotAorta</ci>
                    <ci>q_TotRenal</ci>
                    <ci>q_TotGut</ci>
                    <ci>q_TotVenaCava</ci>
                    <ci>q_TotLimbs</ci>
                </apply>
            </apply>
        </math>
        <!-- ===========      Baroreceptor        ===========
 ref: Magosso2001AndUrsino2000 -->
        <variable name="u_sys" units="J_per_m3"/>
        <variable name="du_sys_dt" units="J_per_m3s"/>
        <variable initial_value="8693.17428214423" name="u_br" public_interface="out" units="J_per_m3"/>
        <variable name="v_br" public_interface="out" units="per_s"/>
        <!-- Constants-->
        <variable initial_value="2.52" name="f_br_min" units="per_s"/>
        <variable initial_value="47.78" name="f_br_max" units="per_s"/>
        <variable initial_value="17267.83628" name="u_nom_br" units="J_per_m3"/>
        <variable initial_value="5000" name="k_br" units="J_per_m3"/>
        <variable initial_value="6.37" name="tau_z_br" units="second"/>
        <variable initial_value="2.076" name="tau_p_br" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>u_sys</ci>
                <apply>
                    <times/>
                    <cn cellml:units="J_per_m3_per_kPa">1000</cn>
                    <ci>u_AA</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>du_sys_dt</ci>
                <apply>
                    <times/>
                    <cn cellml:units="J_per_m3_per_kPa">1000</cn>
                    <ci>duAA_dt</ci>
                </apply>
            </apply>
            <!-- Conservation law-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>u_br</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <apply>
                            <plus/>
                            <ci>u_sys</ci>
                            <apply>
                                <times/>
                                <ci>tau_z_br</ci>
                                <ci>du_sys_dt</ci>
                            </apply>
                        </apply>
                        <ci>u_br</ci>
                    </apply>
                    <ci>tau_p_br</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_br</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <ci>f_br_min</ci>
                        <apply>
                            <times/>
                            <ci>f_br_max</ci>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <minus/>
                                        <ci>u_br</ci>
                                        <ci>u_nom_br</ci>
                                    </apply>
                                    <ci>k_br</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <ci>u_br</ci>
                                    <ci>u_nom_br</ci>
                                </apply>
                                <ci>k_br</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <!-- ===========      cardiopulmonary_receptor_Gee2023        ===========-->
        <!-- u_mus is closest equivalent to P_thor in Finbar's lung model
 TODO: u_mus should be coupeld to diaphragm muscle pressure-->
        <variable initial_value="-1000" name="u_mus" units="J_per_m3"/>
        <variable name="u_pv_u_thor" public_interface="out" units="J_per_m3"/>
        <variable initial_value="4429.11114903453" name="u_cp" public_interface="out" units="J_per_m3"/>
        <variable name="v_cp" public_interface="out" units="per_s"/>
        <!-- constants-->
        <variable initial_value="2" name="tau_cp" units="second"/>
        <variable initial_value="1440" name="u_tn" units="J_per_m3"/>
        <variable initial_value="190.47809" name="k_cp" units="J_per_m3"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>u_pv_u_thor</ci>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <cn cellml:units="J_per_m3_per_kPa">1000</cn>
                        <ci>u_pulmA</ci>
                    </apply>
                    <ci>u_mus</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>u_cp</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <ci>u_cp</ci>
                        </apply>
                        <ci>u_pv_u_thor</ci>
                    </apply>
                    <ci>tau_cp</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_cp</ci>
                <apply>
                    <divide/>
                    <ci>f_max_cp</ci>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <ci>u_tn</ci>
                                    <ci>u_cp</ci>
                                </apply>
                                <ci>k_cp</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <!-- ===========      Lung Strech Receptor        ===========-->
        <!-- constants-->
        <variable initial_value="0.1" name="tau_lung" units="second"/>
        <variable initial_value="33.291" name="G_al" units="per_m3_s"/>
        <variable initial_value="0" name="phi_lung" units="radian"/>
        <variable initial_value="5" name="T_lung_0" units="second"/>
        <variable name="T_lung" units="second"/>
        <variable initial_value="0.001" name="q_lung_max" units="m3"/>
        <variable name="q_lung_amp" units="m3"/>
        <variable initial_value="0.004" name="q_lung_baseline" units="m3"/>
        <!-- input: must be coupled or use a sin input-->
        <variable name="q_lung_V" units="m3"/>
        <!-- outputs-->
        <variable initial_value="0.1290455656029" name="v_ls" public_interface="out" units="per_s"/>
        <variable name="omega_lung" units="per_s"/>
        <!-- equations-->
        <!--==================        Simulation protocol         ==============-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>T_lung</ci>
                <piecewise>
                    <piece>
                        <ci>T_lung_0</ci>
                        <apply>
                            <or/>
                            <apply>
                                <lt/>
                                <ci>t</ci>
                                <ci>t_start_T_lung</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>t</ci>
                                <ci>t_end_T_lung</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <times/>
                            <ci>T_lung_0</ci>
                            <ci>T_lung_multiplier</ci>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>q_lung_amp</ci>
                <piecewise>
                    <piece>
                        <ci>q_lung_max</ci>
                        <apply>
                            <or/>
                            <apply>
                                <lt/>
                                <ci>t</ci>
                                <ci>t_start_q_lung_amp</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>t</ci>
                                <ci>t_end_q_lung_amp</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <times/>
                            <ci>q_lung_max</ci>
                            <ci>q_lung_max_multiplier</ci>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <!--====================================================================-->
            <apply>
                <eq/>
                <ci>omega_lung</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="dim">2</cn>
                        <pi/>
                    </apply>
                    <ci>T_lung</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>q_lung_V</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>q_lung_amp</ci>
                        <apply>
                            <sin/>
                            <apply>
                                <plus/>
                                <apply>
                                    <times/>
                                    <ci>omega_lung</ci>
                                    <ci>t</ci>
                                </apply>
                                <ci>phi_lung</ci>
                            </apply>
                        </apply>
                    </apply>
                    <ci>q_lung_baseline</ci>
                </apply>
            </apply>
            <!-- ode(v_ls, t) = tau_lung*(-v_ls+G_al*V_lung);
 changed so that tau has correct units of seconds. tau should be a time constant
 Finbar has modified this to measure bronchiole stressed volume, and only increase frequency when this 
 stressed volume is above zero.-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>v_ls</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <ci>v_ls</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>G_al</ci>
                            <apply>
                                <max/>
                                <ci>q_lung_V</ci>
                                <cn cellml:units="m3">0</cn>
                            </apply>
                        </apply>
                    </apply>
                    <ci>tau_lung</ci>
                </apply>
            </apply>
        </math>
        <!-- ===========      Chemoreceptor        ===========-->
        <!-- inp variables: Must be coupeld to lung air flow module - set as boundary inputs at this stage-->
        <variable initial_value="0.48" name="C_CO2_a0" units="dimensionless"/>
        <variable initial_value="0.2" name="C_O2_a0" units="dimensionless"/>
        <variable name="C_O2_a" units="dimensionless"/>
        <variable name="C_CO2_a" units="dimensionless"/>
        <variable initial_value="0" name="dot_C_CO2_a" units="per_s"/>
        <!-- output variables-->
        <variable name="X_O2" public_interface="out" units="dimensionless"/>
        <variable name="phi_stat" public_interface="out" units="per_s"/>
        <variable initial_value="0.0" name="phi_CO2_dyn" public_interface="out" units="per_s"/>
        <variable name="v_chemo_stat" public_interface="out" units="per_s"/>
        <variable name="v_chemo_dyn" public_interface="out" units="per_s"/>
        <variable name="v_chemo_apc" public_interface="out" units="per_s"/>
        <variable initial_value="2.47451997643197" name="phi_apc" public_interface="out" units="per_s"/>
        <variable name="u_chemo_O2_a" public_interface="out" units="J_per_m3"/>
        <!-- Constants-->
        <variable initial_value="600" name="AA" units="dimensionless"/>
        <variable initial_value="10.18" name="BB" units="dimensionless"/>
        <variable initial_value="0.36" name="C_CO2_a_nom" units="dimensionless"/>
        <variable initial_value="200" name="K_O2" units="dimensionless"/>
        <variable initial_value="1" name="K_CO2" units="per_s"/>
        <variable initial_value="20" name="K_stat" units="per_s"/>
        <variable initial_value="45" name="K_dyn" units="per_s"/>
        <variable initial_value="3.5" name="tau_cap" units="second"/>
        <variable initial_value="600" name="tau_CO2_cc_dyn" units="dimensionless"/>
        <variable initial_value="150" name="Hgb" units="kg_per_m3"/>
        <variable initial_value="0.20448" name="C_O2_sat" units="dimensionless"/>
        <variable initial_value="1.9564" name="C_CO2_sat" units="dimensionless"/>
        <variable initial_value="2.33e-7" name="alpha_O2" units="m3_per_J"/>
        <variable initial_value="2.4e-4" name="alpha_1" units="m3_per_J"/>
        <variable initial_value="4.19e-4" name="alpha_2" units="m3_per_J"/>
        <variable initial_value="6.21e-5" name="beta_1" units="m3_per_J"/>
        <variable initial_value="2.44e-4" name="beta_2" units="m3_per_J"/>
        <variable initial_value="1998.5" name="k_1" units="J_per_m3"/>
        <variable initial_value="25917.4" name="k_2" units="J_per_m3"/>
        <variable initial_value="0.3836" name="h_1" units="dimensionless"/>
        <variable initial_value="1.819" name="h_2" units="dimensionless"/>
        <!-- private variables-->
        <variable name="S_O2_a" public_interface="out" units="dimensionless"/>
        <variable name="C_O2_a_diss" public_interface="out" units="dimensionless"/>
        <variable name="d_1" public_interface="out" units="J_per_m3"/>
        <variable name="d_2" public_interface="out" units="J_per_m3"/>
        <variable name="r_1" public_interface="out" units="J_per_m3"/>
        <variable name="r_2" public_interface="out" units="J_per_m3"/>
        <variable name="s_1" public_interface="out" units="J2_per_m6"/>
        <variable name="s_2" public_interface="out" units="J2_per_m6"/>
        <!-- equations-->
        <!--==================        Simulation protocol         ==============-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>C_O2_a</ci>
                <piecewise>
                    <piece>
                        <ci>C_O2_a0</ci>
                        <apply>
                            <or/>
                            <apply>
                                <lt/>
                                <ci>t</ci>
                                <ci>t_start_C_O2</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>t</ci>
                                <ci>t_end_C_O2</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <times/>
                            <ci>C_O2_a0</ci>
                            <ci>C_O2_multiplier</ci>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>C_CO2_a</ci>
                <piecewise>
                    <piece>
                        <ci>C_CO2_a0</ci>
                        <apply>
                            <or/>
                            <apply>
                                <lt/>
                                <ci>t</ci>
                                <ci>t_start_C_CO2</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>t</ci>
                                <ci>t_end_C_CO2</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <times/>
                            <ci>C_CO2_a0</ci>
                            <ci>C_CO2_multiplier</ci>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <!--====================================================================-->
            <apply>
                <eq/>
                <ci>d_1</ci>
                <apply>
                    <max/>
                    <apply>
                        <times/>
                        <ci>k_1</ci>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <ci>C_O2_a</ci>
                                <apply>
                                    <minus/>
                                    <ci>C_O2_sat</ci>
                                    <ci>C_O2_a</ci>
                                </apply>
                            </apply>
                            <ci>h_1</ci>
                        </apply>
                    </apply>
                    <cn cellml:units="J_per_m3">0</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>d_2</ci>
                <apply>
                    <max/>
                    <apply>
                        <times/>
                        <ci>k_2</ci>
                        <apply>
                            <power/>
                            <apply>
                                <divide/>
                                <ci>C_CO2_a</ci>
                                <apply>
                                    <minus/>
                                    <ci>C_CO2_sat</ci>
                                    <ci>C_CO2_a</ci>
                                </apply>
                            </apply>
                            <ci>h_2</ci>
                        </apply>
                    </apply>
                    <cn cellml:units="J_per_m3">0</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>r_1</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">0.5</cn>
                        </apply>
                        <apply>
                            <minus/>
                            <apply>
                                <minus/>
                                <apply>
                                    <plus/>
                                    <cn cellml:units="dimensionless">1</cn>
                                    <apply>
                                        <times/>
                                        <ci>beta_1</ci>
                                        <ci>d_2</ci>
                                    </apply>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>beta_2</ci>
                                    <ci>d_1</ci>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <ci>alpha_1</ci>
                                <ci>alpha_2</ci>
                                <ci>d_1</ci>
                                <ci>d_2</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>beta_2</ci>
                        <apply>
                            <times/>
                            <ci>alpha_2</ci>
                            <ci>beta_1</ci>
                            <ci>d_2</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>r_2</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">0.5</cn>
                        </apply>
                        <apply>
                            <minus/>
                            <apply>
                                <minus/>
                                <apply>
                                    <plus/>
                                    <cn cellml:units="dimensionless">1</cn>
                                    <apply>
                                        <times/>
                                        <ci>beta_2</ci>
                                        <ci>d_1</ci>
                                    </apply>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>beta_1</ci>
                                    <ci>d_2</ci>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <ci>alpha_2</ci>
                                <ci>alpha_1</ci>
                                <ci>d_2</ci>
                                <ci>d_1</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>beta_1</ci>
                        <apply>
                            <times/>
                            <ci>alpha_1</ci>
                            <ci>beta_2</ci>
                            <ci>d_1</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>s_1</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                        <apply>
                            <plus/>
                            <ci>d_1</ci>
                            <apply>
                                <times/>
                                <ci>alpha_1</ci>
                                <ci>d_1</ci>
                                <ci>d_2</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>beta_2</ci>
                        <apply>
                            <times/>
                            <ci>alpha_2</ci>
                            <ci>beta_1</ci>
                            <ci>d_2</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>s_2</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                        <apply>
                            <plus/>
                            <ci>d_2</ci>
                            <apply>
                                <times/>
                                <ci>alpha_2</ci>
                                <ci>d_2</ci>
                                <ci>d_1</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>beta_1</ci>
                        <apply>
                            <times/>
                            <ci>alpha_1</ci>
                            <ci>beta_2</ci>
                            <ci>d_1</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_chemo_O2_a</ci>
                <apply>
                    <plus/>
                    <ci>r_1</ci>
                    <apply>
                        <root/>
                        <apply>
                            <minus/>
                            <apply>
                                <power/>
                                <ci>r_1</ci>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                            <ci>s_1</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>C_O2_a_diss</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <times/>
                            <ci>u_chemo_O2_a</ci>
                            <ci>alpha_O2</ci>
                        </apply>
                        <apply>
                            <geq/>
                            <apply>
                                <minus/>
                                <apply>
                                    <minus/>
                                    <ci>C_O2_sat</ci>
                                    <apply>
                                        <times/>
                                        <ci>Hgb</ci>
                                        <cn cellml:units="m3_per_kg" type="e-notation">1.34<sep/>-3</cn>
                                    </apply>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>u_chemo_O2_a</ci>
                                    <ci>alpha_O2</ci>
                                </apply>
                            </apply>
                            <cn cellml:units="dimensionless">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <minus/>
                            <ci>C_O2_sat</ci>
                            <apply>
                                <times/>
                                <ci>Hgb</ci>
                                <cn cellml:units="m3_per_kg" type="e-notation">1.34<sep/>-3</cn>
                            </apply>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>S_O2_a</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>C_O2_a</ci>
                        <ci>C_O2_a_diss</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Hgb</ci>
                        <cn cellml:units="m3_per_kg" type="e-notation">1.34<sep/>-3</cn>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>X_O2</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>AA</ci>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>S_O2_a</ci>
                        </apply>
                    </apply>
                    <ci>BB</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>phi_stat</ci>
                <apply>
                    <times/>
                    <ci>K_CO2</ci>
                    <apply>
                        <minus/>
                        <ci>C_CO2_a</ci>
                        <ci>C_CO2_a_nom</ci>
                    </apply>
                    <ci>K_O2</ci>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <ci>X_O2</ci>
                                </apply>
                                <ci>K_O2</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_chemo_stat</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <times/>
                            <ci>K_stat</ci>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <minus/>
                                            <ci>phi_stat</ci>
                                        </apply>
                                        <ci>K_stat</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <geq/>
                            <ci>C_CO2_a</ci>
                            <ci>C_CO2_a_nom</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="per_s">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>phi_CO2_dyn</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>dot_C_CO2_a</ci>
                            <ci>tau_CO2_cc_dyn</ci>
                        </apply>
                        <ci>phi_CO2_dyn</ci>
                    </apply>
                    <ci>tau_cap</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_chemo_dyn</ci>
                <apply>
                    <times/>
                    <ci>K_dyn</ci>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <ci>phi_CO2_dyn</ci>
                                </apply>
                                <ci>K_dyn</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>phi_apc</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <apply>
                            <plus/>
                            <ci>v_chemo_stat</ci>
                            <ci>v_chemo_dyn</ci>
                        </apply>
                        <ci>phi_apc</ci>
                    </apply>
                    <ci>tau_cap</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_chemo_apc</ci>
                <apply>
                    <max/>
                    <ci>phi_apc</ci>
                    <cn cellml:units="per_s">0</cn>
                </apply>
            </apply>
        </math>
        <!-- ===========      NTS        ===========-->
        <!-- outputs-->
        <variable name="v_NTS_br" public_interface="out" units="per_s"/>
        <variable name="v_NTS_ls" public_interface="out" units="per_s"/>
        <variable name="v_NTS_cp" public_interface="out" units="per_s"/>
        <variable name="v_NTS_chemo" public_interface="out" units="per_s"/>
        <!-- constants-->
        <variable initial_value="0.304" name="f_min_br" units="per_s"/>
        <variable initial_value="21.499" name="f_max_br" units="per_s"/>
        <variable initial_value="44.125" name="f_mid_br" units="per_s"/>
        <variable initial_value="0.451" name="f_min_cp" units="per_s"/>
        <variable initial_value="28.327" name="f_max_cp" units="per_s"/>
        <variable initial_value="20.2" name="f_mid_cp" units="per_s"/>
        <variable initial_value="2.75" name="f_min_ls" units="per_s"/>
        <variable initial_value="31.569" name="f_max_ls" units="per_s"/>
        <variable initial_value="0.13" name="f_mid_ls" units="per_s"/>
        <variable initial_value="2.11" name="f_min_ch" units="per_s"/>
        <variable initial_value="24.4" name="f_max_ch" units="per_s"/>
        <variable initial_value="17.7" name="f_mid_ch" units="per_s"/>
        <variable initial_value="21" name="k_NTS_br" units="dimensionless"/>
        <variable initial_value="2" name="k_NTS_ls" units="dimensionless"/>
        <variable initial_value="7" name="k_NTS_cp" units="dimensionless"/>
        <variable initial_value="1.86" name="k_NTS_ch" units="dimensionless"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_NTS_br</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>f_min_br</ci>
                            <ci>f_max_br</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <ci>v_br</ci>
                                    <ci>f_mid_br</ci>
                                </apply>
                                <ci>k_NTS_br</ci>
                            </apply>
                        </apply>
                    </apply>
                    <ci>f_max_br</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_NTS_ls</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>f_min_ls</ci>
                            <ci>f_max_ls</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <ci>v_ls</ci>
                                    <ci>f_mid_ls</ci>
                                </apply>
                                <ci>k_NTS_ls</ci>
                            </apply>
                        </apply>
                    </apply>
                    <ci>f_max_ls</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_NTS_cp</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>f_min_cp</ci>
                            <ci>f_max_cp</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <ci>v_cp</ci>
                                    <ci>f_mid_cp</ci>
                                </apply>
                                <ci>k_NTS_cp</ci>
                            </apply>
                        </apply>
                    </apply>
                    <ci>f_max_cp</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_NTS_chemo</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>f_min_ch</ci>
                            <ci>f_max_ch</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <ci>v_chemo_apc</ci>
                                    <ci>f_mid_ch</ci>
                                </apply>
                                <ci>k_NTS_ch</ci>
                            </apply>
                        </apply>
                    </apply>
                    <ci>f_max_ch</ci>
                </apply>
            </apply>
        </math>
        <!-- ===========      NA        ===========-->
        <!-- inputs: s_floor comes from lung module :  -->
        <variable name="s_floor" units="dimensionless"/>
        <!-- outputs-->
        <variable name="v_NTS_output" public_interface="out" units="per_s"/>
        <variable name="v_NA_input" public_interface="out" units="per_s"/>
        <variable name="v_NA" public_interface="out" units="per_s"/>
        <!-- constants-->
        <variable initial_value="0.5" name="k_RSA" units="dimensionless"/>
        <variable initial_value="4.88" name="f_min_NA" units="per_s"/>
        <variable initial_value="15.78" name="f_max_NA" units="per_s"/>
        <variable initial_value="30" name="f_mid_NA" units="per_s"/>
        <variable initial_value="23" name="k_NA" units="dimensionless"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_NTS_output</ci>
                <apply>
                    <plus/>
                    <ci>v_NTS_br</ci>
                    <ci>v_NTS_ls</ci>
                    <ci>v_NTS_cp</ci>
                    <ci>v_NTS_chemo</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_NA_input</ci>
                <piecewise>
                    <piece>
                        <ci>v_NTS_output</ci>
                        <apply>
                            <gt/>
                            <ci>s_floor</ci>
                            <cn cellml:units="dimensionless">0.4</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <times/>
                            <ci>v_NTS_output</ci>
                            <ci>k_RSA</ci>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>v_NA</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>f_min_NA</ci>
                            <ci>f_max_NA</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <ci>v_NA_input</ci>
                                    <ci>f_mid_NA</ci>
                                </apply>
                                <ci>k_NA</ci>
                            </apply>
                        </apply>
                    </apply>
                    <ci>f_max_NA</ci>
                </apply>
            </apply>
        </math>
        <!-- ===========      DMV        ===========
 constants-->
        <variable initial_value="2.59" name="f_min_DMV" units="per_s"/>
        <variable initial_value="6.66" name="f_max_DMV" units="per_s"/>
        <variable initial_value="42.91" name="f_mid_DMV" units="per_s"/>
        <variable initial_value="33.5" name="k_DMV" units="dimensionless"/>
        <!-- outputs-->
        <variable name="v_DMV_out" public_interface="out" units="per_s"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_DMV_out</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>f_min_DMV</ci>
                            <ci>f_max_DMV</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <plus/>
                                        <ci>v_NTS_ls</ci>
                                        <ci>v_NTS_cp</ci>
                                    </apply>
                                    <ci>f_mid_DMV</ci>
                                </apply>
                                <ci>k_DMV</ci>
                            </apply>
                        </apply>
                    </apply>
                    <ci>f_max_DMV</ci>
                </apply>
            </apply>
        </math>
        <!-- ===========      NA_ino        ===========-->
        <!-- constants-->
        <variable initial_value="0.61" name="f_min_NAino" units="per_s"/>
        <variable initial_value="11" name="f_max_NAino" units="per_s"/>
        <variable initial_value="12.81" name="f_mid_NAino" units="per_s"/>
        <variable initial_value="23" name="k_NAino" units="dimensionless"/>
        <!-- outputs-->
        <variable name="v_NAino" public_interface="out" units="per_s"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_NAino</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>f_min_NAino</ci>
                            <ci>f_max_NAino</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <ci>v_NA</ci>
                                    <ci>f_mid_NAino</ci>
                                </apply>
                                <ci>k_NAino</ci>
                            </apply>
                        </apply>
                    </apply>
                    <ci>f_max_NAino</ci>
                </apply>
            </apply>
        </math>
        <!-- ===========      RVLM         ===========-->
        <!-- outputs-->
        <variable name="f_RVLM_premax" public_interface="out" units="per_s"/>
        <variable name="v_RVLM" public_interface="out" units="per_s"/>
        <!-- Constants-->
        <variable initial_value="16.11" name="f_RVLM_0" units="per_s"/>
        <variable initial_value="2.1" name="f_RVLM_inf" units="per_s"/>
        <variable initial_value="60" name="f_RVLM_max" units="per_s"/>
        <variable initial_value="0.0675" name="k_RVLM" units="second"/>
        <variable initial_value="-1.47" name="W_br" units="dimensionless"/>
        <variable initial_value="5" name="W_chemo" units="dimensionless"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>f_RVLM_premax</ci>
                <apply>
                    <plus/>
                    <ci>f_RVLM_inf</ci>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <ci>f_RVLM_0</ci>
                            <ci>f_RVLM_inf</ci>
                        </apply>
                        <apply>
                            <exp/>
                            <apply>
                                <times/>
                                <ci>k_RVLM</ci>
                                <apply>
                                    <plus/>
                                    <apply>
                                        <times/>
                                        <ci>W_br</ci>
                                        <ci>v_br</ci>
                                    </apply>
                                    <apply>
                                        <times/>
                                        <ci>W_chemo</ci>
                                        <ci>v_chemo_apc</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_RVLM</ci>
                <piecewise>
                    <piece>
                        <ci>f_RVLM_premax</ci>
                        <apply>
                            <leq/>
                            <ci>f_RVLM_premax</ci>
                            <ci>f_RVLM_max</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>f_RVLM_max</ci>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- ===========      LCN        ===========-->
        <!-- constants-->
        <variable initial_value="4.47" name="k_evEmax_gainLCN" units="dimensionless"/>
        <variable initial_value="2.49" name="k_br_gainLCN" units="dimensionless"/>
        <variable initial_value="0.0594" name="k_RVLM_gainLCN" units="dimensionless"/>
        <variable initial_value="6.95" name="k_cp_gainLCN" units="dimensionless"/>
        <variable initial_value="737" name="f_mid_LCN" units="per_s"/>
        <variable initial_value="1.25" name="f_min_LCN" units="per_s"/>
        <variable initial_value="30.5" name="f_max_LCN" units="per_s"/>
        <variable initial_value="4.32" name="k_LCN" units="dimensionless"/>
        <!-- outputs-->
        <variable name="v_input_LCN_sum" public_interface="out" units="per_s"/>
        <variable name="v_input_LCN" public_interface="out" units="per_s"/>
        <variable name="v_LCN" public_interface="out" units="per_s"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_input_LCN_sum</ci>
                <apply>
                    <plus/>
                    <apply>
                        <minus/>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <ci>k_evEmax_gainLCN</ci>
                                <apply>
                                    <plus/>
                                    <ci>v_DMV_out</ci>
                                    <ci>v_NAino</ci>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <ci>k_br_gainLCN</ci>
                                <ci>v_br</ci>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>k_RVLM_gainLCN</ci>
                            <ci>v_RVLM</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_cp_gainLCN</ci>
                        <ci>v_cp</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_input_LCN</ci>
                <piecewise>
                    <piece>
                        <ci>v_input_LCN_sum</ci>
                        <apply>
                            <geq/>
                            <ci>v_input_LCN_sum</ci>
                            <cn cellml:units="per_s">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="per_s">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>v_LCN</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>f_min_LCN</ci>
                            <ci>f_max_LCN</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <ci>v_input_LCN</ci>
                                    <ci>f_mid_LCN</ci>
                                </apply>
                                <ci>k_LCN</ci>
                            </apply>
                        </apply>
                    </apply>
                    <ci>f_max_LCN</ci>
                </apply>
            </apply>
        </math>
        <!-- ===========      PNNA        ===========-->
        <!-- inputs - TODO: should be coupled correspondingly-->
        <variable name="f_vagal_stim" units="per_s"/>
        <!-- ===========      simulation protocol         ===========-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>f_vagal_stim</ci>
                <piecewise>
                    <piece>
                        <cn cellml:units="per_s">0</cn>
                        <apply>
                            <or/>
                            <apply>
                                <lt/>
                                <ci>t</ci>
                                <ci>t_start_vagal_stim</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>t</ci>
                                <ci>t_end_vagal_stim</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>vagal_stim_freq</ci>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!-- ========================================================-->
        <!-- constants-->
        <variable initial_value="1.039" name="f_min_PNNA" units="per_s"/>
        <variable initial_value="17.9" name="f_max_PNNA" units="per_s"/>
        <variable initial_value="8.5" name="f_mid_PNNA" units="per_s"/>
        <variable initial_value="1.98" name="k_PNNA" units="dimensionless"/>
        <!-- outputs-->
        <variable name="v_PNNA_natural" public_interface="out" units="per_s"/>
        <variable name="v_PNNA" public_interface="out" units="per_s"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_PNNA_natural</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>f_min_PNNA</ci>
                            <ci>f_max_PNNA</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <plus/>
                                        <ci>v_NA</ci>
                                        <ci>v_LCN</ci>
                                    </apply>
                                    <ci>f_mid_PNNA</ci>
                                </apply>
                                <ci>k_PNNA</ci>
                            </apply>
                        </apply>
                    </apply>
                    <ci>f_max_PNNA</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_PNNA</ci>
                <apply>
                    <plus/>
                    <ci>v_PNNA_natural</ci>
                    <ci>f_vagal_stim</ci>
                </apply>
            </apply>
        </math>
        <!-- ===========      PNDMV        ===========-->
        <!-- constants-->
        <variable initial_value="10.4" name="f_mid_PNDMV" units="per_s"/>
        <variable initial_value="9.35" name="f_min_PNDMV" units="per_s"/>
        <variable initial_value="28.2" name="f_max_PNDMV" units="per_s"/>
        <variable initial_value="23.8" name="k_PNDMV" units="dimensionless"/>
        <variable initial_value="2.53" name="tau_PNDMV" units="second"/>
        <!-- outputs-->
        <variable name="v_PNDMV" public_interface="out" units="per_s"/>
        <variable initial_value="21.9565661323856" name="v_PNDMV_filt" public_interface="out" units="per_s"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>v_PNDMV</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>f_min_PNDMV</ci>
                            <ci>f_max_PNDMV</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <plus/>
                                        <ci>v_DMV_out</ci>
                                        <ci>v_NAino</ci>
                                        <ci>v_LCN</ci>
                                    </apply>
                                    <ci>f_mid_PNDMV</ci>
                                </apply>
                                <ci>k_PNDMV</ci>
                            </apply>
                        </apply>
                    </apply>
                    <ci>f_max_PNDMV</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>v_PNDMV_filt</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>v_PNDMV</ci>
                        <ci>v_PNDMV_filt</ci>
                    </apply>
                    <ci>tau_PNDMV</ci>
                </apply>
            </apply>
        </math>
        <!-- ===========      lv_elastance_effector        ===========-->
        <!-- outputs-->
        <variable name="sigma_lv_Es" public_interface="out" units="J_per_m6"/>
        <variable initial_value="37655714.7138116" name="Delta_lv_Es" public_interface="out" units="J_per_m6"/>
        <variable name="sigma_lv_Ev" public_interface="out" units="J_per_m6"/>
        <variable initial_value="-21508.1810252261" name="Delta_lv_Ev" public_interface="out" units="J_per_m6"/>
        <variable name="Delta_lv_Emax" public_interface="out" units="J_per_m6"/>
        <!-- constants-->
        <!-- value changed from 1084065.576 to increase sensitivity to sympathetic activity-->
        <variable initial_value="15084065.576" name="G_lv_Es" units="J_per_m6"/>
        <variable initial_value="0.2" name="tau_lv_Es" units="second"/>
        <variable initial_value="-1000" name="G_lv_Ev" units="Js_per_m6"/>
        <variable initial_value="0.2" name="tau_lv_Ev" units="second"/>
        <variable initial_value="1" name="scale_lv_E" units="dimensionless"/>
        <variable initial_value="2.66" name="f_es_min" units="per_s"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>sigma_lv_Es</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <times/>
                            <ci>G_lv_Es</ci>
                            <apply>
                                <ln/>
                                <apply>
                                    <times/>
                                    <cn cellml:units="second">1</cn>
                                    <apply>
                                        <plus/>
                                        <apply>
                                            <minus/>
                                            <ci>v_RVLM</ci>
                                            <ci>f_es_min</ci>
                                        </apply>
                                        <cn cellml:units="per_s">1</cn>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <geq/>
                            <ci>v_RVLM</ci>
                            <ci>f_es_min</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="J_per_m6">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Delta_lv_Es</ci>
                </apply>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>tau_lv_Es</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <ci>Delta_lv_Es</ci>
                        </apply>
                        <ci>sigma_lv_Es</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>sigma_lv_Ev</ci>
                <apply>
                    <times/>
                    <ci>G_lv_Ev</ci>
                    <ci>v_PNDMV_filt</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Delta_lv_Ev</ci>
                </apply>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>tau_lv_Ev</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <ci>Delta_lv_Ev</ci>
                        </apply>
                        <ci>sigma_lv_Ev</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Delta_lv_Emax</ci>
                <apply>
                    <times/>
                    <ci>scale_lv_E</ci>
                    <apply>
                        <plus/>
                        <ci>Delta_lv_Es</ci>
                        <ci>Delta_lv_Ev</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!-- ===========      rv_elastance_effector        ===========-->
        <!-- outputs-->
        <variable name="sigma_rv_Es" public_interface="out" units="J_per_m6"/>
        <variable initial_value="19579175.826722" name="Delta_rv_Es" public_interface="out" units="J_per_m6"/>
        <variable name="sigma_rv_Ev" public_interface="out" units="J_per_m6"/>
        <variable initial_value="-2150705.989567" name="Delta_rv_Ev" public_interface="out" units="J_per_m6"/>
        <variable name="Delta_rv_Emax" public_interface="out" units="J_per_m6"/>
        <!-- constants-->
        <variable initial_value="8000000" name="G_rv_Es" units="J_per_m6"/>
        <variable initial_value="2" name="tau_rv_Es" units="second"/>
        <variable initial_value="-100000" name="G_rv_Ev" units="Js_per_m6"/>
        <variable initial_value="0.2" name="tau_rv_Ev" units="second"/>
        <variable initial_value="0.5903" name="scale_rv_E" units="dimensionless"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>sigma_rv_Es</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <times/>
                            <ci>G_rv_Es</ci>
                            <apply>
                                <ln/>
                                <apply>
                                    <times/>
                                    <cn cellml:units="second">1</cn>
                                    <apply>
                                        <plus/>
                                        <apply>
                                            <minus/>
                                            <ci>v_RVLM</ci>
                                            <ci>f_es_min</ci>
                                        </apply>
                                        <cn cellml:units="per_s">1</cn>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <geq/>
                            <ci>v_RVLM</ci>
                            <ci>f_es_min</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="J_per_m6">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Delta_rv_Es</ci>
                </apply>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>tau_rv_Es</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <ci>Delta_rv_Es</ci>
                        </apply>
                        <ci>sigma_rv_Es</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>sigma_rv_Ev</ci>
                <apply>
                    <times/>
                    <ci>G_rv_Ev</ci>
                    <ci>v_PNDMV_filt</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Delta_rv_Ev</ci>
                </apply>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <cn cellml:units="dimensionless">1</cn>
                        <ci>tau_rv_Ev</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <ci>Delta_rv_Ev</ci>
                        </apply>
                        <ci>sigma_rv_Ev</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Delta_rv_Emax</ci>
                <apply>
                    <times/>
                    <ci>scale_rv_E</ci>
                    <apply>
                        <plus/>
                        <ci>Delta_rv_Es</ci>
                        <ci>Delta_rv_Ev</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!-- ===========      heart period effector        ===========-->
        <!-- f_v copupled to v_PNNA
 outputs: TODO: couple delta_heart_T to the heart module-->
        <variable initial_value="-0.733220437110031" name="Delta_heart_Ts" public_interface="out" units="second"/>
        <variable initial_value="0.684177420373057" name="Delta_heart_Tv" public_interface="out" units="second"/>
        <variable name="Delta_heart_T" public_interface="out" units="second"/>
        <variable name="sigma_heart_Ts" public_interface="out" units="second"/>
        <variable name="sigma_heart_Tv" public_interface="out" units="second"/>
        <!-- constants-->
        <!-- value changed from -0.2 to -0.3 to increase sensitivity to sympathetic activity-->
        <variable initial_value="-0.3" name="G_heart_Ts" units="second"/>
        <variable initial_value="0.05" name="G_heart_Tv" units="s2"/>
        <variable initial_value="2" name="tau_heart_Ts" units="second"/>
        <variable initial_value="1.5" name="tau_heart_Tv" units="second"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>sigma_heart_Ts</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <times/>
                            <ci>G_heart_Ts</ci>
                            <apply>
                                <ln/>
                                <apply>
                                    <times/>
                                    <cn cellml:units="second">1</cn>
                                    <apply>
                                        <plus/>
                                        <apply>
                                            <minus/>
                                            <ci>v_RVLM</ci>
                                            <ci>f_es_min</ci>
                                        </apply>
                                        <cn cellml:units="per_s">1</cn>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <geq/>
                            <ci>v_RVLM</ci>
                            <ci>f_es_min</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="second">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Delta_heart_Ts</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <ci>Delta_heart_Ts</ci>
                        </apply>
                        <ci>sigma_heart_Ts</ci>
                    </apply>
                    <ci>tau_heart_Ts</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>sigma_heart_Tv</ci>
                <apply>
                    <times/>
                    <ci>G_heart_Tv</ci>
                    <ci>v_PNNA</ci>
                </apply>
            </apply>
            <!--DELAY IGNORED-->
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Delta_heart_Tv</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <ci>Delta_heart_Tv</ci>
                        </apply>
                        <ci>sigma_heart_Tv</ci>
                    </apply>
                    <ci>tau_heart_Tv</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Delta_heart_T</ci>
                <apply>
                    <plus/>
                    <ci>Delta_heart_Tv</ci>
                    <ci>Delta_heart_Ts</ci>
                </apply>
            </apply>
        </math>
        <!-- ===========      venous unstressed volume and compliance effector        ===========-->
        <!-- outputs-->
        <variable name="Delta_theta_us" public_interface="out" units="dimensionless"/>
        <variable initial_value="11.121606629691" name="sigma_theta_us" public_interface="out" units="per_s"/>
        <variable name="Delta_theta_compliance" public_interface="out" units="dimensionless"/>
        <variable initial_value="11.121606629691" name="sigma_theta_compliance" public_interface="out" units="per_s"/>
        <!-- constants-->
        <variable initial_value="0.3" name="G_theta_us" units="dimensionless"/>
        <variable initial_value="0.3" name="G_theta_compliance" units="dimensionless"/>
        <variable initial_value="20" name="tau_theta_us" units="second"/>
        <variable initial_value="20" name="tau_theta_compliance" units="second"/>
        <!-- Equations
 TODO for both of the below, it probably shouln't be additive. It should be impossible to get to negative.
 changed the below from ln to hill function so we can limit the amount it can change compliance and us volume. Now G_theta_us is the maximum amount of change
 that can occur to the us volume
 G_theta is now a max proportion of us volume or compliance that can be decreased.-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>sigma_theta_us</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <apply>
                            <max/>
                            <apply>
                                <minus/>
                                <ci>v_RVLM</ci>
                                <ci>f_es_min</ci>
                            </apply>
                            <cn cellml:units="per_s">0</cn>
                        </apply>
                        <ci>sigma_theta_us</ci>
                    </apply>
                    <ci>tau_theta_us</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Delta_theta_us</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>G_theta_compliance</ci>
                        <ci>sigma_theta_us</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>f_es_min</ci>
                        <ci>sigma_theta_us</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>sigma_theta_compliance</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <apply>
                            <max/>
                            <apply>
                                <minus/>
                                <ci>v_RVLM</ci>
                                <ci>f_es_min</ci>
                            </apply>
                            <cn cellml:units="per_s">0</cn>
                        </apply>
                        <ci>sigma_theta_compliance</ci>
                    </apply>
                    <ci>tau_theta_compliance</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Delta_theta_compliance</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>G_theta_compliance</ci>
                        <ci>sigma_theta_compliance</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>f_es_min</ci>
                        <ci>sigma_theta_compliance</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!-- ===========      arm-leg resistance effector        ===========-->
        <!-- Constants-->
        <variable initial_value="227000000" name="G_armLeg_theta" units="Js_per_m6"/>
        <variable initial_value="6" name="tau_armLeg_theta" units="second"/>
        <!-- outputs-->
        <variable initial_value="601095917.449606" name="Delta_armLeg_theta" public_interface="out" units="Js_per_m6"/>
        <variable name="sigma_armLeg_theta" public_interface="out" units="Js_per_m6"/>
        <!-- Equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>sigma_armLeg_theta</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <times/>
                            <ci>G_armLeg_theta</ci>
                            <apply>
                                <ln/>
                                <apply>
                                    <times/>
                                    <cn cellml:units="second">1</cn>
                                    <apply>
                                        <plus/>
                                        <apply>
                                            <minus/>
                                            <ci>v_RVLM</ci>
                                            <ci>f_es_min</ci>
                                        </apply>
                                        <cn cellml:units="per_s">1</cn>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <geq/>
                            <ci>v_RVLM</ci>
                            <ci>f_es_min</ci>
                        </apply>
                    </piece>
                    <otherwise>
                        <cn cellml:units="Js_per_m6">0</cn>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Delta_armLeg_theta</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <ci>Delta_armLeg_theta</ci>
                        </apply>
                        <ci>sigma_armLeg_theta</ci>
                    </apply>
                    <ci>tau_armLeg_theta</ci>
                </apply>
            </apply>
        </math>
        <!-- ===========      Blood Volume Control: left Kidney        ===========-->
        <!-- outputs-->
        <variable name="u_lpt_W" units="kPa"/>
        <variable initial_value="0.521056165876984" name="q_lpt_W" units="litre"/>
        <variable name="c_lpt_Na" units="mol_per_L"/>
        <variable name="C_lpt_Na" units="mM"/>
        <variable initial_value="0.00805209530950799" name="q_lpt_Na" units="mole"/>
        <variable initial_value="0.00460774921555305" name="q_lptEpi_Na" units="mole"/>
        <variable name="c_lptEpi_Na" units="mol_per_L"/>
        <variable name="C_lptEpi_Na" units="mM"/>
        <variable name="c_lPeritubularC_Na" units="mol_per_L"/>
        <variable name="C_lPeritubularC_Na" units="mM"/>
        <variable name="u_lpt_osmotic" units="kPa"/>
        <variable name="u_lPeritubularC_osmotic" units="kPa"/>
        <variable initial_value="-0.040" name="u_lptEpi_e" units="J_per_C"/>
        <variable name="v_lgl_W" units="L_per_s"/>
        <variable name="v_lpt_W" units="L_per_s"/>
        <variable name="v_lpt_Na" units="mol_per_s"/>
        <variable name="v_lptEpi_NKE" units="mol_per_s"/>
        <variable name="v_lgl_Na" units="mol_per_s"/>
        <variable initial_value="0.03" name="q_lPeritubularC_K" units="mole"/>
        <variable initial_value="0.012" name="q_lptEpi_K" units="mole"/>
        <!-- boundary conditions-->
        <variable initial_value="0" name="v_out2_W" units="L_per_s"/>
        <variable initial_value="1.16e-6" name="v_out2_Na" units="mol_per_s"/>
        <!-- constants-->
        <variable initial_value="2.5e3" name="RT" units="J_per_mol"/>
        <variable initial_value="0.965e5" name="F" units="C_per_mol"/>
        <variable initial_value="1" name="E_pt" units="joule"/>
        <variable initial_value="0.1" name="U_pt_W" units="litre"/>
        <variable initial_value="1" name="L_pt_W" units="litre"/>
        <variable initial_value="0.5" name="q_lptEpi_W" units="litre"/>
        <variable initial_value="0" name="k_pt_W" units="L_per_s_per_kPa"/>
        <variable initial_value="5" name="k_gl_W" units="L_per_s_per_kPa"/>
        <variable initial_value="1" name="kK_pt_Na" units="per_s"/>
        <variable initial_value="1" name="kK_gl_Na" units="per_s"/>
        <variable initial_value="1e5" name="k_ptEpi_NKE" units="mol_per_s"/>
        <variable initial_value="1" name="K_Na" units="L_per_mol"/>
        <variable initial_value="1" name="K_K" units="L_per_mol"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_lpt_W</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <ci>v_lgl_W</ci>
                        <ci>v_lpt_W</ci>
                    </apply>
                    <ci>v_out2_W</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_lptEpi_Na</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>v_lpt_Na</ci>
                    <ci>v_lptEpi_NKE</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_lpt_Na</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <ci>v_lgl_Na</ci>
                        <ci>v_lpt_Na</ci>
                    </apply>
                    <ci>v_out2_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_lpt_W</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>E_pt</ci>
                        <apply>
                            <minus/>
                            <ci>q_lpt_W</ci>
                            <ci>U_pt_W</ci>
                        </apply>
                    </apply>
                    <apply>
                        <power/>
                        <apply>
                            <minus/>
                            <ci>L_pt_W</ci>
                            <ci>q_lpt_W</ci>
                        </apply>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>c_lpt_Na</ci>
                <apply>
                    <divide/>
                    <ci>q_lpt_Na</ci>
                    <ci>q_lpt_W</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>c_lptEpi_Na</ci>
                <apply>
                    <divide/>
                    <ci>q_lptEpi_Na</ci>
                    <ci>q_lptEpi_W</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>c_lPeritubularC_Na</ci>
                <apply>
                    <divide/>
                    <ci>q_vc_Na</ci>
                    <ci>q_lPeritubularC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>C_lpt_Na</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dim" type="e-notation">1<sep/>3</cn>
                    <ci>c_lpt_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>C_lptEpi_Na</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dim" type="e-notation">1<sep/>3</cn>
                    <ci>c_lptEpi_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>C_lPeritubularC_Na</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dim" type="e-notation">1<sep/>3</cn>
                    <ci>c_lPeritubularC_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_lpt_osmotic</ci>
                <apply>
                    <times/>
                    <ci>RT</ci>
                    <ci>c_lpt_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_lPeritubularC_osmotic</ci>
                <apply>
                    <times/>
                    <ci>RT</ci>
                    <ci>c_lPeritubularC_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_lpt_W</ci>
                <apply>
                    <times/>
                    <ci>k_pt_W</ci>
                    <apply>
                        <minus/>
                        <ci>u_lPeritubularC_osmotic</ci>
                        <ci>u_lpt_osmotic</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_lpt_Na</ci>
                <apply>
                    <times/>
                    <ci>kK_pt_Na</ci>
                    <apply>
                        <minus/>
                        <ci>q_lpt_Na</ci>
                        <ci>q_lptEpi_Na</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_lptEpi_NKE</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="dim">3</cn>
                        <ci>k_ptEpi_NKE</ci>
                        <apply>
                            <minus/>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_Na</ci>
                                            <ci>q_lptEpi_Na</ci>
                                        </apply>
                                        <ci>q_lptEpi_W</ci>
                                    </apply>
                                    <cn cellml:units="dim">3</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_K</ci>
                                            <ci>q_lPeritubularC_K</ci>
                                        </apply>
                                        <ci>q_lPeritubularC</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_Na</ci>
                                            <ci>q_vc_Na</ci>
                                        </apply>
                                        <ci>q_lPeritubularC</ci>
                                    </apply>
                                    <cn cellml:units="dim">3</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_K</ci>
                                            <ci>q_lptEpi_K</ci>
                                        </apply>
                                        <ci>q_lptEpi_W</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <cn cellml:units="dim">2</cn>
                                            <ci>F</ci>
                                            <ci>u_lptEpi_e</ci>
                                        </apply>
                                        <ci>RT</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <cn cellml:units="dim">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_Na</ci>
                                        <ci>q_lptEpi_Na</ci>
                                    </apply>
                                    <ci>q_lptEpi_W</ci>
                                </apply>
                                <cn cellml:units="dim">3</cn>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dim">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_Na</ci>
                                        <ci>q_vc_Na</ci>
                                    </apply>
                                    <ci>q_lPeritubularC</ci>
                                </apply>
                                <cn cellml:units="dim">3</cn>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dim">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_K</ci>
                                        <ci>q_lPeritubularC_K</ci>
                                    </apply>
                                    <ci>q_lPeritubularC</ci>
                                </apply>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dim">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_K</ci>
                                        <ci>q_lptEpi_K</ci>
                                    </apply>
                                    <ci>q_lptEpi_W</ci>
                                </apply>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_lgl_W</ci>
                <apply>
                    <times/>
                    <ci>k_gl_W</ci>
                    <apply>
                        <minus/>
                        <ci>u_lGlomerulusC</ci>
                        <ci>u_lpt_W</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_lgl_Na</ci>
                <apply>
                    <times/>
                    <ci>kK_gl_Na</ci>
                    <apply>
                        <minus/>
                        <ci>q_vc_Na</ci>
                        <ci>q_lpt_Na</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!-- ===========      Blood Volume Control: right Kidney        ===========-->
        <!-- constants-->
        <variable initial_value="0.5" name="q_rptEpi_W" units="litre"/>
        <!-- outputs-->
        <variable name="u_rpt_W" units="kPa"/>
        <variable initial_value="0.520759656230573" name="q_rpt_W" units="litre"/>
        <variable name="c_rpt_Na" units="mol_per_L"/>
        <variable name="C_rpt_Na" units="mM"/>
        <variable initial_value="0.00805190956611238" name="q_rpt_Na" units="mole"/>
        <variable initial_value="0.0046073280304522" name="q_rptEpi_Na" units="mole"/>
        <variable name="c_rptEpi_Na" units="mol_per_L"/>
        <variable name="C_rptEpi_Na" units="mM"/>
        <variable name="c_rPeritubularC_Na" units="mol_per_L"/>
        <variable name="C_rPeritubularC_Na" units="mM"/>
        <variable name="u_rpt_osmotic" units="kPa"/>
        <variable name="u_rPeritubularC_osmotic" units="kPa"/>
        <variable initial_value="-0.040" name="u_rptEpi_e" units="J_per_C"/>
        <variable name="v_rgl_W" units="L_per_s"/>
        <variable name="v_rpt_W" units="L_per_s"/>
        <variable name="v_rpt_Na" units="mol_per_s"/>
        <variable name="v_rptEpi_NKE" units="mol_per_s"/>
        <variable name="v_rgl_Na" units="mol_per_s"/>
        <variable initial_value="0.03" name="q_rPeritubularC_K" units="mole"/>
        <variable initial_value="0.012" name="q_rptEpi_K" units="mole"/>
        <!-- equations-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_rpt_W</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <ci>v_rgl_W</ci>
                        <ci>v_rpt_W</ci>
                    </apply>
                    <ci>v_out2_W</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_rptEpi_Na</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>v_rpt_Na</ci>
                    <ci>v_rptEpi_NKE</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_rpt_Na</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <ci>v_rgl_Na</ci>
                        <ci>v_rpt_Na</ci>
                    </apply>
                    <ci>v_out2_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_rpt_W</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>E_pt</ci>
                        <apply>
                            <minus/>
                            <ci>q_rpt_W</ci>
                            <ci>U_pt_W</ci>
                        </apply>
                    </apply>
                    <apply>
                        <power/>
                        <apply>
                            <minus/>
                            <ci>L_pt_W</ci>
                            <ci>q_rpt_W</ci>
                        </apply>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>c_rpt_Na</ci>
                <apply>
                    <divide/>
                    <ci>q_rpt_Na</ci>
                    <ci>q_rpt_W</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>c_rptEpi_Na</ci>
                <apply>
                    <divide/>
                    <ci>q_rptEpi_Na</ci>
                    <ci>q_rptEpi_W</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>c_rPeritubularC_Na</ci>
                <apply>
                    <divide/>
                    <ci>q_vc_Na</ci>
                    <ci>q_rPeritubularC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>C_rpt_Na</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dim" type="e-notation">1<sep/>3</cn>
                    <ci>c_rpt_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>C_rptEpi_Na</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dim" type="e-notation">1<sep/>3</cn>
                    <ci>c_rptEpi_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>C_rPeritubularC_Na</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dim" type="e-notation">1<sep/>3</cn>
                    <ci>c_rPeritubularC_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_rpt_osmotic</ci>
                <apply>
                    <times/>
                    <ci>RT</ci>
                    <ci>c_rpt_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>u_rPeritubularC_osmotic</ci>
                <apply>
                    <times/>
                    <ci>RT</ci>
                    <ci>c_rPeritubularC_Na</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_rpt_W</ci>
                <apply>
                    <times/>
                    <ci>k_pt_W</ci>
                    <apply>
                        <minus/>
                        <ci>u_rPeritubularC_osmotic</ci>
                        <ci>u_rpt_osmotic</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_rpt_Na</ci>
                <apply>
                    <times/>
                    <ci>kK_pt_Na</ci>
                    <apply>
                        <minus/>
                        <ci>q_rpt_Na</ci>
                        <ci>q_rptEpi_Na</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>v_rptEpi_NKE</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <cn cellml:units="dim">3</cn>
                        <ci>k_ptEpi_NKE</ci>
                        <apply>
                            <minus/>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_Na</ci>
                                            <ci>q_rptEpi_Na</ci>
                                        </apply>
                                        <ci>q_rptEpi_W</ci>
                                    </apply>
                                    <cn cellml:units="dim">3</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_K</ci>
                                            <ci>q_rPeritubularC_K</ci>
                                        </apply>
                                        <ci>q_rPeritubularC</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_Na</ci>
                                            <ci>q_vc_Na</ci>
                                        </apply>
                                        <ci>q_rPeritubularC</ci>
                                    </apply>
                                    <cn cellml:units="dim">3</cn>
                                </apply>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>K_K</ci>
                                            <ci>q_rptEpi_K</ci>
                                        </apply>
                                        <ci>q_rptEpi_W</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <cn cellml:units="dim">2</cn>
                                            <ci>F</ci>
                                            <ci>u_rptEpi_e</ci>
                                        </apply>
                                        <ci>RT</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <cn cellml:units="dim">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_Na</ci>
                                        <ci>q_rptEpi_Na</ci>
                                    </apply>
                                    <ci>q_rptEpi_W</ci>
                                </apply>
                                <cn cellml:units="dim">3</cn>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dim">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_Na</ci>
                                        <ci>q_vc_Na</ci>
                                    </apply>
                                    <ci>q_rPeritubularC</ci>
                                </apply>
                                <cn cellml:units="dim">3</cn>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="dim">1</cn>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>K_K</ci>
                                        <ci>q_rPeritubularC_K</ci>
                                    </apply>
                                    <ci>q_rPeritubularC</ci>
                                </apply>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
