diff --git a/src/sedml/kisaomap.cpp b/src/sedml/kisaomap.cpp
index 919bd2b..b399426 100644
--- a/src/sedml/kisaomap.cpp
+++ b/src/sedml/kisaomap.cpp
@@ -38,13 +38,23 @@
  * 
  */
  
-#include <map>
-#include <string>
+#include <algorithm>
+#include <cstddef>
+#include <iterator>
 #include "sedml/common/libsedml-version.h"
 
 LIBSEDML_CPP_NAMESPACE_BEGIN
 
-std::map<int, std::string> g_kisaomap = {
+// libOpenCOR: use a constant array (sorted by KiSAO id) rather than a std::map, so that it doesn't need to be built
+//             when libSEDML is loaded.
+
+struct KisaoTerm
+{
+   int id;
+   const char* name;
+};
+
+static constexpr KisaoTerm KISAO_TERMS[] = {
    {0, "modelling and simulation algorithm"},
    {3, "weighted stochastic simulation algorithm"},
    {15, "Gillespie first reaction algorithm"},
@@ -567,5 +577,16 @@ std::map<int, std::string> g_kisaomap = {
    {858, "variance ignoring NaN"},
    {859, "variance"},
 };
+
+const char*
+getKisaoTermName(int kisaoID)
+{
+  const KisaoTerm* end = std::end(KISAO_TERMS);
+  const KisaoTerm* term = std::lower_bound(std::begin(KISAO_TERMS), end, kisaoID,
+    [](const KisaoTerm& kisaoTerm, int id) { return kisaoTerm.id < id; });
+
+  return ((term != end) && (term->id == kisaoID)) ? term->name : NULL;
+}
+
 LIBSEDML_CPP_NAMESPACE_END
 
