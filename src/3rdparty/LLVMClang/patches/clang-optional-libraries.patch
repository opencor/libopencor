   IntervalPartition.cpp
   IssueHash.cpp
   LiveVariables.cpp
-  MacroExpansionContext.cpp
   ObjCNoReturn.cpp
   PathDiagnostic.cpp
   PostOrderCFGView.cpp
@@ -35,14 +53,14 @@ add_clang_library(clangAnalysis
