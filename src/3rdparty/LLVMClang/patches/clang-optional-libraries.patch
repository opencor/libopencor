   UnsafeBufferUsage.cpp
+  ${CLANG_ANALYSIS_TOOLING_SOURCES}
 
   LINK_LIBS
   clangAST
   clangASTMatchers
   clangBasic
-  clangFormat
   clangLex
-  clangToolingCore
+  ${CLANG_ANALYSIS_TOOLING_LIBS}
 
   DEPENDS
   omp_gen
@@ -50,6 +68,8 @@ add_clang_library(clangAnalysis
   )
 
 add_subdirectory(plugins)
-add_subdirectory(FlowSensitive)
 add_subdirectory(LifetimeSafety)
-add_subdirectory(Scalable)
+if(CLANG_ENABLE_TOOLING_LIBS)
