+# libOpenCOR: only emit the tables of the intrinsics and of the runtime library calls of the targets that are built (see
+# LLVM_ENABLE_ALL_TARGETS_SUPPORT in llvm/CMakeLists.txt), i.e. their intrinsic prefixes and system runtime libraries.
+# Note: the system runtime library that is not specific to any target (LegacyDefaultSystemLibrary) is needed by the
+#       targets that don't have their own.
+set(INTRINSIC_IMPL_TARGETS_ARG)
+set(RUNTIME_LIBCALLS_SYSTEM_LIBRARIES_ARG)
+if(NOT LLVM_ENABLE_ALL_TARGETS_SUPPORT)
+  set(intrinsic_prefixes)
+  set(system_libraries)
+  foreach(target ${LLVM_TARGETS_TO_BUILD})
+    if(target STREQUAL "AArch64")
+      list(APPEND intrinsic_prefixes aarch64)
+      list(APPEND system_libraries AArch64SystemLibrary WindowsARM64ECSystemLibrary)
+    elseif(target STREQUAL "AMDGPU")
+      list(APPEND intrinsic_prefixes amdgcn r600)
+      list(APPEND system_libraries AMDGPUSystemLibrary)
+    elseif(target STREQUAL "ARM")
+      list(APPEND intrinsic_prefixes arm)
+      list(APPEND system_libraries ARMSystemLibrary)
+    elseif(target STREQUAL "AVR")
+      list(APPEND system_libraries AVRSystemLibrary)
+    elseif(target STREQUAL "BPF")
+      list(APPEND intrinsic_prefixes bpf)
+      list(APPEND system_libraries LegacyDefaultSystemLibrary)
