diff --git a/llvm/CMakeLists.txt b/llvm/CMakeLists.txt
index fcbfed4..ff3cbfe 100644
--- a/llvm/CMakeLists.txt
+++ b/llvm/CMakeLists.txt
@@ -684,6 +684,29 @@ option(LLVM_ENABLE_PEDANTIC "Compile with pedantic enabled." ON)
 option(LLVM_ENABLE_WERROR "Fail and stop if a warning is triggered." OFF)
 
 option(LLVM_ENABLE_DUMP "Enable dump functions even when assertions are disabled" OFF)
+
+# libOpenCOR: allow the optimizations that LLVM's default pipelines only perform when given profile data or a vector
+# library (-fveclib=), when enabled through a command-line option (-mllvm) or a pipeline tuning option that is off by
+# default (loop interchange, loop fusion, function merging and speculative devirtualization), or on code that uses
+# OpenMP or coroutines, to be compiled out, so as to minimise the footprint of an embedder that never uses them. When
+# this option is disabled, the default pipelines are otherwise unchanged, profile data, vector libraries and those
+# pipeline tuning options result in a fatal error, the command-line options that would enable those optimizations are
+# not available, coroutines are not supported, and the analyses that the default pipelines never use are not registered
+# (so they cannot be used in a textual pipeline).
+option(LLVM_ENABLE_OPTIONAL_OPTIMIZATIONS
+  "Support the optimizations that LLVM's default pipelines only perform with profile data, a vector library, a command-line option, a non-default pipeline tuning option, OpenMP or coroutines." ON)
+
+# libOpenCOR: allow the SLP vectorizer to be compiled out, so as to minimise the footprint of an embedder that never
+# uses it (i.e. that never sets PipelineTuningOptions::SLPVectorization). When this option is disabled, setting
+# PipelineTuningOptions::SLPVectorization results in a fatal error.
+option(LLVM_ENABLE_SLP_VECTORIZER "Support SLP vectorization." ON)
+
+# libOpenCOR: allow the code generator's support for inline assembly and debug information, as well as the demangling
+# of names in diagnostics, to be compiled out, so as to minimise the footprint of an embedder that never uses them.
+# When this option is disabled, inline assembly and debug information result in a fatal error, and diagnostics
+# report mangled names.
+option(LLVM_ENABLE_OPTIONAL_CODE_GENERATION
+  "Support inline assembly and debug information in the code generator, and demangled names in diagnostics." ON)
 option(LLVM_UNREACHABLE_OPTIMIZE "Optimize llvm_unreachable() as undefined behavior (default), guaranteed trap when OFF" ON)
 
 if( NOT uppercase_CMAKE_BUILD_TYPE STREQUAL "DEBUG" )
@@ -852,6 +875,12 @@ option(LLVM_BUILD_TESTS
   "Build LLVM unit tests. If OFF, just generate build targets." OFF)
 option(LLVM_INCLUDE_TESTS "Generate build targets for the LLVM unit tests." ON)
 
+# libOpenCOR: see LLVM_ENABLE_OPTIONAL_OPTIMIZATIONS, LLVM_ENABLE_SLP_VECTORIZER and
+# LLVM_ENABLE_OPTIONAL_CODE_GENERATION above.
+if(LLVM_INCLUDE_TESTS AND NOT (LLVM_ENABLE_OPTIONAL_OPTIMIZATIONS AND LLVM_ENABLE_SLP_VECTORIZER AND LLVM_ENABLE_OPTIONAL_CODE_GENERATION))
+  message(FATAL_ERROR "LLVM_INCLUDE_TESTS requires LLVM_ENABLE_OPTIONAL_OPTIMIZATIONS, LLVM_ENABLE_SLP_VECTORIZER and LLVM_ENABLE_OPTIONAL_CODE_GENERATION.")
+endif()
+
 option(LLVM_INSTALL_GTEST
   "Install the llvm gtest library.  This should be on if you want to do
    stand-alone builds of the other projects and run their unit tests." OFF)
