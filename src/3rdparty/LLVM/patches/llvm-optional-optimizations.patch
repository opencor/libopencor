+
+//===----------------------------------------------------------------------===//
+// Bit vector options.
+
+// External storage.
+template <class DataType, class StorageClass> class bits_storage {
+  unsigned *Location = nullptr;
+
+  template <class T> static unsigned Bit(const T &V) {
+    return 1 << static_cast<unsigned>(V);
+  }
+
+public:
+  constexpr bits_storage() = default;
+
+  constexpr void setLocation(unsigned &L) { Location = &L; }
+
+  template <class T> void addValue(const T &V) { *Location |= Bit(V); }
+
+  unsigned getBits() { return *Location; }
+
+  void clear() {
+    if (Location)
+      *Location = 0;
+  }
+
+  template <class T> bool isSet(const T &V) {
+    return (*Location & Bit(V)) != 0;
+  }
+};
+
+// Internal storage.
+template <class DataType> class bits_storage<DataType, bool> {
+  unsigned Bits = 0;
+
+  template <class T> static unsigned Bit(const T &V) {
+    return 1 << static_cast<unsigned>(V);
+  }
+
+public:
+  template <class T> void addValue(const T &V) { Bits |= Bit(V); }
+
+  unsigned getBits() { return Bits; }
+
+  void clear() { Bits = 0; }
+
+  template <class T> bool isSet(const T &V) { return (Bits & Bit(V)) != 0; }
+};
+
+template <class DataType, class Storage = bool,
+          class ParserClass = parser<DataType>>
+class bits : public OptionHolderBase, public bits_storage<DataType, Storage> {
+  template <class Ty>
+  constexpr void applyModifier(const LocationClass<Ty> &L) {
+    this->setLocation(L.Loc);
+  }
+  template <class Mod> constexpr void applyModifier(const Mod &) {}
+
+public:
+  bits(const bits &) = delete;
+  bits &operator=(const bits &) = delete;
+
+  template <class... Mods> constexpr explicit bits(const Mods &...Ms) {
+    (applyModifier(Ms), ...);
+  }
+
+  unsigned getPosition(unsigned) const { return 0; }
+
+  template <class F> void setCallback(const F &) {}
+};
+
