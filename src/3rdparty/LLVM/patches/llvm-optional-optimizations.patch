+// libOpenCOR: see LLVM_ENABLE_ALL_TARGETS_SUPPORT in
+// llvm/CMakeLists.txt. Keep the names of the implementations that are members
+// of a kept system library, or of no system library at all (they may be made
+// available by code, e.g. vector library functions).
+void RuntimeLibcallEmitter::computeKeptNames() {
+  DenseSet<const RuntimeLibcallImpl *> InSomeLibrary;
+  for (const Record *R :
+       Records.getAllDerivedDefinitions("SystemRuntimeLibrary")) {
+    SetTheory Sets;
+    DenseMap<const RuntimeLibcallImpl *,
+             std::pair<std::vector<const Record *>, const Record *>>
+        Func2Preds;
+    Sets.addExpander("LibcallImpls", std::make_unique<LibcallPredicateExpander>(
+                                         Libcalls, Func2Preds));
+    bool Kept = is_contained(KeptSystemLibraries, R->getName());
+    for (const Record *Elt : *Sets.expand(R->getValueAsDef("MemberList"))) {
+      const RuntimeLibcallImpl *Impl = Libcalls.getRuntimeLibcallImpl(Elt);
+      if (!Impl)
+        continue;
+      InSomeLibrary.insert(Impl);
+      if (Kept)
+        KeptNames.insert(Impl->getLibcallFuncName());
+    }
+  }
+  for (const RuntimeLibcallImpl &Impl : Libcalls.getRuntimeLibcallImplDefList())
+    if (!InSomeLibrary.contains(&Impl))
+      KeptNames.insert(Impl.getLibcallFuncName());
+}
+
 void RuntimeLibcallEmitter::run(raw_ostream &OS) {
   emitSourceFileHeader("Runtime LibCalls Source Fragment", OS, Records);
+  if (omitsSystemLibraries()) {
+    for (const std::string &Name : KeptSystemLibraries) {
+      const Record *R = Records.getDef(Name);
+      if (!R || !R->isSubClassOf("SystemRuntimeLibrary"))
+        PrintFatalError("unknown system runtime library '" + Name + "'");
+    }
+    computeKeptNames();
+  }
   emitGetRuntimeLibcallEnum(OS);
 
   emitGetInitRuntimeLibcallNames(OS);
