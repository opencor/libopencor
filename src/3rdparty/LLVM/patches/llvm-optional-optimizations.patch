+// Aliases.
+
+class alias : public OptionHolderBase {
+public:
+  alias(const alias &) = delete;
+  alias &operator=(const alias &) = delete;
+
+  template <class... Mods> constexpr explicit alias(const Mods &...) {}
+};
+
+struct aliasopt {
+  template <class Opt> constexpr explicit aliasopt(Opt &) {}
+};
