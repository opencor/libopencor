diff --git a/llvm/CMakeLists.txt b/llvm/CMakeLists.txt
index fcbfed4..76919c6 100644
--- a/llvm/CMakeLists.txt
+++ b/llvm/CMakeLists.txt
@@ -684,6 +684,122 @@ option(LLVM_ENABLE_PEDANTIC "Compile with pedantic enabled." ON)
 option(LLVM_ENABLE_WERROR "Fail and stop if a warning is triggered." OFF)
 
 option(LLVM_ENABLE_DUMP "Enable dump functions even when assertions are disabled" OFF)
+
+# libOpenCOR: allow the optimizations that LLVM's default pipelines only perform when given profile data or a vector
+# library (-fveclib=), when enabled through a command-line option (-mllvm), a target option or a pipeline tuning option
+# that is off by default (loop interchange, loop fusion, function merging and speculative devirtualization), on code
+# that is optimized for size (minsize), or on code that uses OpenMP, coroutines, Objective-C ARC, allocation tokens or
+# alignment assumptions, as well as LTO, to be compiled out, so as to minimise the footprint of an embedder that never
+# uses them. When this option is disabled, the default pipelines are otherwise unchanged, profile data, vector
+# libraries, LTO, those target and pipeline tuning options, minsize code that the machine outliner would otherwise
+# outline, Objective-C ARC, allocation tokens and alignment assumptions result in a fatal error, the command-line
+# options that would enable those optimizations (or select another register allocator or instruction scheduler) are
+# either not available or result in a fatal error, coroutines are not supported, and the analyses that the default
+# pipelines never use are not registered (so they cannot be used in a textual pipeline).
+option(LLVM_ENABLE_OPTIONAL_OPTIMIZATIONS
+  "Support the optimizations that LLVM's default pipelines only perform with profile data, a vector library, a command-line option, a target option, a non-default pipeline tuning option, minsize code, OpenMP, coroutines, Objective-C ARC, allocation tokens or alignment assumptions, as well as LTO." ON)
+
+# libOpenCOR: allow the SLP vectorizer to be compiled out, so as to minimise the footprint of an embedder that never
+# uses it (i.e. that never sets PipelineTuningOptions::SLPVectorization). When this option is disabled, setting
+# PipelineTuningOptions::SLPVectorization results in a fatal error.
+option(LLVM_ENABLE_SLP_VECTORIZER "Support SLP vectorization." ON)
+
+# libOpenCOR: allow LLVM's loop optimizations (i.e. the loop passes of LLVM's default pipelines, such as loop
+# vectorization, loop unrolling and LICM, and the code generator's loop passes, such as loop strength reduction) to be
+# compiled out, so as to minimise the footprint of an embedder whose code never contains any loops. When this option is
+# disabled, the default pipelines and the code generator are otherwise unchanged, so code that never contains any loops
+# is optimized exactly as before, but optimizing (or generating optimized code for) a function that contains a loop,
+# including one that LLVM itself creates (e.g. through tail recursion elimination or the expansion of atomics, memory
+# intrinsics or large divisions), results in a fatal error.
+option(LLVM_ENABLE_LOOP_OPTIMIZATIONS
+  "Support loop optimizations (e.g. loop vectorization, loop unrolling, LICM and loop strength reduction)." ON)
+
+# libOpenCOR: allow the support for vector operations in LLVM IR (i.e. the instructions and intrinsics that operate on
+# vectors, in the optimizer and in the code generator's translation of IR) to be compiled out, so as to minimise the
+# footprint of an embedder whose IR never contains any and that doesn't vectorize it (i.e. with
+# LLVM_ENABLE_SLP_VECTORIZER and LLVM_ENABLE_LOOP_OPTIMIZATIONS disabled). When this option is disabled, the default
+# pipelines and the code generator are otherwise unchanged (the code generator may still use vector instructions, e.g.
+# to merge consecutive stores), but optimizing (or generating code for) IR that contains vector operations results in a
+# fatal error.
+option(LLVM_ENABLE_VECTOR_IR "Support vector operations in LLVM IR." ON)
+
+# libOpenCOR: allow dead store elimination (DSE) to be compiled out, so as to minimise the footprint of an embedder that
+# always skips it (e.g. through a ShouldRunOptionalPass callback). When this option is disabled, the default pipelines
+# are unchanged (they still contain DSEPass, so that it can be skipped exactly as before), but running DSE results in a
+# fatal error.
+option(LLVM_ENABLE_DEAD_STORE_ELIMINATION "Support dead store elimination (DSE)." ON)
+
+# libOpenCOR: allow the code generator's support for inline assembly, debug information (including DWARF line tables
+# and CodeView), exception handling, setjmp/longjmp handling (WebAssembly), Swift error handling, garbage collection,
+# stack maps, patch points, statepoints, deoptimization, stack protection, fake uses, basic block sections and address
+# maps, SFrame unwind tables, Just My Code instrumentation, Windows secure hot patching and textual assembly, as well as
+# the demangling of names in diagnostics, to be compiled out, so as to minimise the footprint of an embedder that never
+# uses them. When this option is disabled, using any of those features results in a fatal error, and diagnostics
+# report mangled names.
+option(LLVM_ENABLE_OPTIONAL_CODE_GENERATION
+  "Support inline assembly, debug information, exception handling, setjmp/longjmp handling, Swift error handling, garbage collection, stack maps, patch points, statepoints, deoptimization, stack protection, fake uses, basic block sections and address maps, SFrame unwind tables, Just My Code instrumentation, Windows secure hot patching and textual assembly in the code generator, and demangled names in diagnostics." ON)
+
+# libOpenCOR: allow the support for debug information in LLVM IR (i.e. DI* metadata, and hence debug locations, debug
+# records and debug intrinsics) to be compiled out, so as to minimise the footprint of an embedder whose IR never
+# contains any. When this option is disabled, IR without debug information is optimized and compiled exactly as before,
+# but creating debug information metadata (e.g. through DIBuilder, or by reading IR that contains some) results in a
+# fatal error.
+option(LLVM_ENABLE_DEBUG_INFORMATION "Support debug information in LLVM IR." ON)
+
+# libOpenCOR: allow LLVM's facilities for debugging LLVM itself (i.e. printing, verifying and serializing IR and MIR,
+# verifying analyses, debugify, viewing graphs, bisecting optimizations, debug counters, optimization remarks enabled
+# through a command-line option, annotation remarks, stack frame layout remarks, some statistics and timing passes) to
+# be compiled out, so as to minimise the footprint of an embedder that never uses them. When this option is disabled,
+# annotation and stack frame layout remarks are not emitted, using any of the other facilities results in a fatal error,
+# and the command-line options that would enable them are either not available or result in a fatal error.
+option(LLVM_ENABLE_DEBUGGING_FACILITIES
+  "Support LLVM's facilities for debugging LLVM itself (e.g. printing and verifying IR and MIR)." ON)
+
+# libOpenCOR: allow LLVM's support for unoptimized code generation (i.e. the O0 pipeline, FastISel, GlobalISel and the
+# fast register allocator, which are only used at OptimizationLevel::O0 or CodeGenOptLevel::None, or when enabled
+# through a command-line option) to be compiled out, so as to minimise the footprint of an embedder that only generates
+# optimized code. When this option is disabled, building the O0 pipeline or generating code at CodeGenOptLevel::None
+# results in a fatal error.
+option(LLVM_ENABLE_UNOPTIMIZED_CODE_GENERATION
+  "Support unoptimized code generation (the O0 pipeline, FastISel, GlobalISel and the fast register allocator)." ON)
+
+# libOpenCOR: allow the support for the object formats other than that of LLVM_HOST_TRIPLE (in MC, Object, JITLink and
+# RuntimeDyld, as well as the code generation that is specific to them, e.g. Arm64EC and Control Flow Guard for COFF),
+# and for the object files of that format other than relocatable ones (e.g. executables and shared libraries) and, for
+# ELF, other than those of the class and data encoding of LLVM_HOST_TRIPLE, to be compiled out, so as to minimise the
+# footprint of an embedder that only generates (or JITs) code for its host. When this option is disabled, using another
+# object format (e.g. generating code for, or querying the object format of, a triple that uses it) or reading an object
+# file that is not relocatable or, for ELF, of another class or data encoding results in a fatal error.
+option(LLVM_ENABLE_ALL_OBJECT_FORMATS
+  "Support all the object formats and object file types, rather than only relocatable object files of the object format of LLVM_HOST_TRIPLE." ON)
+
+# libOpenCOR: allow the support for the targets that are not built (i.e. the tables of their intrinsics and runtime
+# library calls, the parts of the code generator that only they use, e.g. some instruction schedulers, and the JIT
+# linking of their code) to be compiled out, so as to minimise the footprint of an embedder that only uses the targets
+# in LLVM_TARGETS_TO_BUILD. When this option is disabled, the IDs of the intrinsics of those targets are unchanged, but
+# using one of those intrinsics, runtime library calls or code, or something that only those targets use, results in a
+# fatal error.
+option(LLVM_ENABLE_ALL_TARGETS_SUPPORT
+  "Support all the targets (their intrinsics, runtime library calls, code generation and JIT linking), rather than only those in LLVM_TARGETS_TO_BUILD." ON)
+
+# libOpenCOR: allow the JIT features that an embedder that JITs code without static initializers or destructors,
+# without concurrent compilation, with LLJIT's default JIT linker and with only its JITDylibs' default resource trackers
+# never uses (i.e. running static initializers and deinitializers, concurrent compilation, which clones modules through
+# bitcode, LLJIT's use of RuntimeDyld for object formats other than COFF and of JITLink for COFF, transferring resources
+# between resource trackers, and the JIT linking of arm64e code) to be compiled out, so as to minimise its footprint.
+# When this option is disabled, using those features results in a fatal error (i.e. LLJIT's JIT linker must be
+# RuntimeDyld for COFF and JITLink otherwise).
+# libOpenCOR: allow LLVM's command-line options (cl::opt, cl::list, cl::bits and cl::alias, and the registration of
+# debug counters) to be compiled out, so as to minimise the footprint of an embedder that never parses them (e.g.
+# through cl::ParseCommandLineOptions()). When this option is disabled, every command-line option is a plain holder of
+# its initial value (which, whenever possible, needs no static constructor) and is neither registered nor given a name
+# or a description, while parsing command-line options or querying the registered ones results in a fatal error. LLVM's
+# own tools that parse command-line options (e.g. llvm-tblgen) are then built as host tools, i.e. with command-line
+# options (see LLVM_USE_HOST_TOOLS below).
+option(LLVM_ENABLE_COMMAND_LINE_OPTIONS "Support LLVM's command-line options." ON)
+
+option(LLVM_ENABLE_OPTIONAL_JIT_FEATURES
+  "Support running static initializers and deinitializers, concurrent compilation and transferring resources between resource trackers in ORC, LLJIT's use of RuntimeDyld for object formats other than COFF and of JITLink for COFF, and the JIT linking of arm64e code." ON)
 option(LLVM_UNREACHABLE_OPTIMIZE "Optimize llvm_unreachable() as undefined behavior (default), guaranteed trap when OFF" ON)
 
 if( NOT uppercase_CMAKE_BUILD_TYPE STREQUAL "DEBUG" )
@@ -852,6 +968,25 @@ option(LLVM_BUILD_TESTS
   "Build LLVM unit tests. If OFF, just generate build targets." OFF)
 option(LLVM_INCLUDE_TESTS "Generate build targets for the LLVM unit tests." ON)
 
+# libOpenCOR: see LLVM_ENABLE_OPTIONAL_OPTIMIZATIONS, LLVM_ENABLE_SLP_VECTORIZER, LLVM_ENABLE_LOOP_OPTIMIZATIONS,
+# LLVM_ENABLE_VECTOR_IR, LLVM_ENABLE_DEAD_STORE_ELIMINATION, LLVM_ENABLE_OPTIONAL_CODE_GENERATION,
+# LLVM_ENABLE_DEBUG_INFORMATION, LLVM_ENABLE_DEBUGGING_FACILITIES, LLVM_ENABLE_UNOPTIMIZED_CODE_GENERATION,
+# LLVM_ENABLE_ALL_OBJECT_FORMATS, LLVM_ENABLE_ALL_TARGETS_SUPPORT, LLVM_ENABLE_COMMAND_LINE_OPTIONS and
+# LLVM_ENABLE_OPTIONAL_JIT_FEATURES above.
+if(LLVM_INCLUDE_TESTS AND NOT (LLVM_ENABLE_OPTIONAL_OPTIMIZATIONS AND LLVM_ENABLE_SLP_VECTORIZER AND LLVM_ENABLE_LOOP_OPTIMIZATIONS
+                               AND LLVM_ENABLE_VECTOR_IR AND LLVM_ENABLE_DEAD_STORE_ELIMINATION
+                               AND LLVM_ENABLE_OPTIONAL_CODE_GENERATION AND LLVM_ENABLE_DEBUG_INFORMATION
+                               AND LLVM_ENABLE_DEBUGGING_FACILITIES AND LLVM_ENABLE_UNOPTIMIZED_CODE_GENERATION
+                               AND LLVM_ENABLE_ALL_OBJECT_FORMATS AND LLVM_ENABLE_ALL_TARGETS_SUPPORT
+                               AND LLVM_ENABLE_COMMAND_LINE_OPTIONS AND LLVM_ENABLE_OPTIONAL_JIT_FEATURES))
+  message(FATAL_ERROR "LLVM_INCLUDE_TESTS requires LLVM_ENABLE_OPTIONAL_OPTIMIZATIONS, LLVM_ENABLE_SLP_VECTORIZER, LLVM_ENABLE_LOOP_OPTIMIZATIONS, LLVM_ENABLE_VECTOR_IR, LLVM_ENABLE_DEAD_STORE_ELIMINATION, LLVM_ENABLE_OPTIONAL_CODE_GENERATION, LLVM_ENABLE_DEBUG_INFORMATION, LLVM_ENABLE_DEBUGGING_FACILITIES, LLVM_ENABLE_UNOPTIMIZED_CODE_GENERATION, LLVM_ENABLE_ALL_OBJECT_FORMATS, LLVM_ENABLE_ALL_TARGETS_SUPPORT, LLVM_ENABLE_COMMAND_LINE_OPTIONS and LLVM_ENABLE_OPTIONAL_JIT_FEATURES.")
+endif()
+
+# libOpenCOR: see LLVM_ENABLE_VECTOR_IR above.
+if(NOT LLVM_ENABLE_VECTOR_IR AND (LLVM_ENABLE_SLP_VECTORIZER OR LLVM_ENABLE_LOOP_OPTIMIZATIONS))
+  message(FATAL_ERROR "LLVM_ENABLE_VECTOR_IR=OFF requires LLVM_ENABLE_SLP_VECTORIZER=OFF and LLVM_ENABLE_LOOP_OPTIMIZATIONS=OFF.")
+endif()
+
 option(LLVM_INSTALL_GTEST
   "Install the llvm gtest library.  This should be on if you want to do
    stand-alone builds of the other projects and run their unit tests." OFF)
@@ -933,8 +1068,9 @@ if (LLVM_LINK_LLVM_DYLIB AND BUILD_SHARED_LIBS)
 endif()
 
 option(LLVM_OPTIMIZED_TABLEGEN "Force TableGen to be built with optimization" OFF)
+# libOpenCOR: see LLVM_ENABLE_COMMAND_LINE_OPTIONS above.
 if(CMAKE_CROSSCOMPILING OR (LLVM_OPTIMIZED_TABLEGEN AND (LLVM_ENABLE_ASSERTIONS
-  OR CMAKE_CONFIGURATION_TYPES OR LLVM_USE_SANITIZER)))
+  OR CMAKE_CONFIGURATION_TYPES OR LLVM_USE_SANITIZER)) OR NOT LLVM_ENABLE_COMMAND_LINE_OPTIONS)
   set(LLVM_USE_HOST_TOOLS ON)
 endif()
 
@@ -1212,6 +1348,55 @@ if (NOT TENSORFLOW_AOT_PATH STREQUAL "")
 
 endif()
 
+# libOpenCOR: the object formats that are supported, i.e. all of them or only that of LLVM_HOST_TRIPLE (see
+# LLVM_ENABLE_ALL_OBJECT_FORMATS above and Triple::getDefaultFormat()).
+set(LLVM_SUPPORTED_OBJECT_FORMATS COFF DXContainer ELF GOFF MachO SPIRV Wasm XCOFF)
+if(NOT LLVM_ENABLE_ALL_OBJECT_FORMATS)
+  if(LLVM_HOST_TRIPLE MATCHES "^wasm")
+    set(LLVM_SUPPORTED_OBJECT_FORMATS Wasm)
+  elseif(LLVM_HOST_TRIPLE MATCHES "-(apple|darwin|macos|ios)")
+    set(LLVM_SUPPORTED_OBJECT_FORMATS MachO)
+  elseif(LLVM_HOST_TRIPLE MATCHES "-(windows|win32|mingw|cygwin)")
+    set(LLVM_SUPPORTED_OBJECT_FORMATS COFF)
+  elseif(LLVM_HOST_TRIPLE MATCHES "-(linux|freebsd|netbsd|openbsd|solaris|elf)")
+    set(LLVM_SUPPORTED_OBJECT_FORMATS ELF)
+  else()
+    message(FATAL_ERROR "The object format of ${LLVM_HOST_TRIPLE} is not known, so LLVM_ENABLE_ALL_OBJECT_FORMATS cannot be OFF.")
+  endif()
+endif()
+foreach(format COFF DXContainer ELF GOFF MachO SPIRV Wasm XCOFF)
+  string(TOUPPER "${format}" uppercase_format)
+  if(format IN_LIST LLVM_SUPPORTED_OBJECT_FORMATS)
+    set(LLVM_ENABLE_${uppercase_format}_OBJECT_FORMAT 1)
+  else()
+    set(LLVM_ENABLE_${uppercase_format}_OBJECT_FORMAT 0)
+  endif()
+endforeach()
+
+# libOpenCOR: the ELF classes and data encodings that are supported, i.e. all of them or only that of LLVM_HOST_TRIPLE
+# (see LLVM_ENABLE_ALL_OBJECT_FORMATS above).
+set(LLVM_SUPPORTED_ELF_VARIANTS ELF32LE ELF32BE ELF64LE ELF64BE)
+if(NOT LLVM_ENABLE_ALL_OBJECT_FORMATS AND LLVM_ENABLE_ELF_OBJECT_FORMAT)
+  if(LLVM_HOST_TRIPLE MATCHES "^(x86_64|amd64|aarch64|arm64|riscv64|loongarch64|powerpc64le|ppc64le|mips64el)-")
+    set(LLVM_SUPPORTED_ELF_VARIANTS ELF64LE)
+  elseif(LLVM_HOST_TRIPLE MATCHES "^(s390x|powerpc64|ppc64|sparcv9|sparc64|mips64)-")
+    set(LLVM_SUPPORTED_ELF_VARIANTS ELF64BE)
+  elseif(LLVM_HOST_TRIPLE MATCHES "^(i[3-6]86|arm|armv[0-9a-z]+|thumb|thumbv[0-9a-z]+|riscv32|mipsel)-")
+    set(LLVM_SUPPORTED_ELF_VARIANTS ELF32LE)
+  elseif(LLVM_HOST_TRIPLE MATCHES "^(armeb|thumbeb|powerpc|ppc|sparc|mips)-")
+    set(LLVM_SUPPORTED_ELF_VARIANTS ELF32BE)
+  else()
+    message(FATAL_ERROR "The ELF class and data encoding of ${LLVM_HOST_TRIPLE} are not known, so LLVM_ENABLE_ALL_OBJECT_FORMATS cannot be OFF.")
+  endif()
+endif()
+foreach(variant ELF32LE ELF32BE ELF64LE ELF64BE)
+  if(LLVM_ENABLE_ELF_OBJECT_FORMAT AND variant IN_LIST LLVM_SUPPORTED_ELF_VARIANTS)
+    set(LLVM_ENABLE_${variant}_OBJECT_FORMAT 1)
+  else()
+    set(LLVM_ENABLE_${variant}_OBJECT_FORMAT 0)
+  endif()
+endforeach()
+
